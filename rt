#!/usr/bin/env bash
set -euo pipefail

# ── Paths (defaults, may be overridden by profile) ────────────────
RT_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RT_HOME="${RT_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/remote-toolkit}"
RT_PROFILE=""
RT_HOST_GROUP=""
RT_PROFILE_NAME=""
RT_HOST_CONF=""
RT_CONF=""
RT_STATE_DIR=""
RT_SESSION_PREFIX=""
RT_SAFE_ID=""

# ── Colors & output helpers ────────────────────────────────────────
_color() { [[ -t 2 ]] && printf '\e[%sm' "$1" >&2 || true; }
_reset() { _color 0; }
info()  { _color 32; printf ':: %s\n' "$*" >&2; _reset; }
warn()  { _color 33; printf '!! %s\n' "$*" >&2; _reset; }
die()   { _color 31; printf 'ERROR: %s\n' "$*" >&2; _reset; exit 1; }
# Same, but exit 2. `rt verify` promises exactly three statuses — 0 equal, 2 blocked or
# unverifiable, 3 not equal at the deadline — so it must never leak the generic 1.
die2()  { _color 31; printf 'ERROR: %s\n' "$*" >&2; _reset; exit 2; }

# ── Platform detection ────────────────────────────────────────────
RT_OS="$(uname -s)"   # "Linux" or "Darwin"

_install_hint() {
  if [[ "$RT_OS" == "Darwin" ]]; then
    case "$1" in
      mutagen) echo "brew install mutagen-io/mutagen/mutagen" ;;
      sshpass) echo "brew install esolitos/ipa/sshpass" ;;
      *)       echo "brew install $1" ;;
    esac
  else
    case "$1" in
      mutagen) echo "see https://mutagen.io/documentation/introduction/installation" ;;
      *)       echo "sudo apt install $1" ;;
    esac
  fi
}

# ── Profile-aware paths ───────────────────────────────────────────
# RT_PROFILE is in <host-group>/<profile-name> form, e.g. "fact-cluster/scratch".
# Each segment: starts with alphanumeric, contains [a-zA-Z0-9-] only, no leading/
# trailing dash, no consecutive dashes, ≤32 chars. The strict charset keeps
# segment encodings injective: Mutagen session name uses '--' as separator,
# tmux session prefix uses '_' as separator.

_validate_segment() {
  local seg="$1" name="$2"
  [[ -n "$seg" ]] \
    || die "Profile parse error: ${name} segment is empty (got '$RT_PROFILE')"
  [[ "$seg" =~ ^[a-zA-Z0-9](-?[a-zA-Z0-9])*$ ]] \
    || die "Profile parse error: ${name} segment '$seg' invalid (must be [a-zA-Z0-9]([a-zA-Z0-9]|-[a-zA-Z0-9])*, got '$RT_PROFILE')"
  [[ ${#seg} -le 32 ]] \
    || die "Profile parse error: ${name} segment '$seg' exceeds 32 chars"
}

# Build paths from RT_PROFILE without validating. Commands that don't need a
# specific profile (status --all, check, help) tolerate empty profile state.
_init_profile() {
  if [[ "${RT_PROFILE:-}" == */* ]]; then
    RT_HOST_GROUP="${RT_PROFILE%%/*}"
    RT_PROFILE_NAME="${RT_PROFILE#*/}"
  else
    RT_HOST_GROUP=""
    RT_PROFILE_NAME=""
  fi
  RT_HOST_CONF="${RT_HOME}/${RT_HOST_GROUP}/host.conf"
  RT_CONF="${RT_HOME}/${RT_HOST_GROUP}/${RT_PROFILE_NAME}.conf"
  RT_STATE_DIR="${RT_HOME}/.rt/${RT_HOST_GROUP}/${RT_PROFILE_NAME}"
  RT_SAFE_ID="${RT_HOST_GROUP}_${RT_PROFILE_NAME}"
  RT_SESSION_PREFIX="rt_${RT_SAFE_ID}_bg_"
}

# Validate that RT_PROFILE is usable. Called by load_config and cmd_init —
# any command that operates on a specific profile.
_require_profile() {
  [[ -n "${RT_PROFILE:-}" ]] \
    || die "Profile required. Use: rt -p <host>/<profile> <command> ..."
  [[ "$RT_PROFILE" == */* ]] \
    || die "Profile must be in <host>/<profile> form (got '$RT_PROFILE'). No bare-name fallback."
  [[ "$RT_PROFILE_NAME" != */* ]] \
    || die "Profile must have exactly one '/'. Got: '$RT_PROFILE'"
  _validate_segment "$RT_HOST_GROUP"   "host-group"
  _validate_segment "$RT_PROFILE_NAME" "profile-name"
  # Canonical display form (post-validation).
  RT_PROFILE="${RT_HOST_GROUP}/${RT_PROFILE_NAME}"
}

# ── Mutagen helpers ────────────────────────────────────────────────
_mutagen_check() {
  command -v mutagen >/dev/null 2>&1 \
    || die "mutagen not found. Ask the user to install: $(_install_hint mutagen)"
}

_mutagen_daemon_ensure() {
  # Idempotent: returns success if already running.
  mutagen daemon start >/dev/null 2>&1 || true
}

_sync_session_name() {
  # '--' separator: Mutagen session names allow alphanumeric+'-' only.
  # Segments forbid consecutive dashes, so '--' is unambiguous.
  echo "rt-${RT_HOST_GROUP}--${RT_PROFILE_NAME}"
}

# Build a Mutagen label-selector for this profile.
# Args: [host-group] [profile-name]; default to globals.
_sync_label_selector() {
  local h="${1:-$RT_HOST_GROUP}" p="${2:-$RT_PROFILE_NAME}"
  echo "rt-host=${h},rt-profile=${p}"
}

# ONE structured probe of the daemon, shared by every classifier below.
#
# The classification used to be a text grep over `mutagen sync list`: anything carrying
# `Identifier:` that did not match `Status:.*Paused` and did not match `Connected: No` was
# called `active`. That is a classifier with no negative case — it decided health from the
# ABSENCE of two strings, so every state Mutagen has that those two strings do not name was
# reported as healthy. Measured 2026-08-05 against Mutagen 0.18.1: a session halted by the
# entry-count circuit breaker reports `Connected: Yes` on both endpoints and
# `Status: Waiting 5 seconds for rescan`, so it classified `active` while synchronising
# nothing.
#
# Fields verified against 0.18.1 (`--template` reads the same session struct the human
# rendering does, so it cannot drift from it the way a grep of the rendering can):
#
#   state                  .Paused  .Status            .LastError
#   healthy                false    Watching           (empty)
#   entry-count halt       false    WaitingForRescan   alpha scan error: exceeded allowed entry count
#   paused                 true     Disconnected       (nil — see below)
#
# `.LastError` lives on the embedded SessionState, which is NIL for a paused session; reading
# it unguarded makes the whole template error out. Hence `{{if .SessionState}}`.
# `.LastError` is NOT sticky — measured: over-cap -> halted, then back under cap -> `Watching`
# with an empty error within one rescan interval. So a non-empty error is a LIVE condition,
# not a scar from an old one, which is what makes it safe to classify on.
# The endpoint-size fields ride along in this SAME template so that every caller reads one
# consistent snapshot of the session rather than several taken at different instants.
# (Probe cost was measured before assuming it mattered: 11 ms, against 438 ms for a trivial
# `rt exec` — about 2.5%. Cheap enough that the size check makes its own call rather than
# threading a cache through every caller.)
# `.Alpha.EndpointState` is nil while an endpoint is disconnected, so it needs its own guard.
# `.Scanned` is the SCOPE of the counts: false means the numbers describe nothing.
#
# `.LastError` stays LAST. `read` puts the whole remainder in the final field, which is what
# keeps an error message containing '|' from shifting every column after it.
RT_SYNC_TEMPLATE='{{range .}}{{.Paused}}|{{.Status}}|{{.Alpha.Connected}}|{{.Beta.Connected}}|{{if .Alpha.EndpointState}}{{.Alpha.EndpointState.Scanned}}|{{.Alpha.EndpointState.Directories}}|{{.Alpha.EndpointState.Files}}|{{.Alpha.EndpointState.TotalFileSize}}{{else}}|||{{end}}|{{if .SessionState}}{{.LastError}}{{end}}
{{end}}'

# Echo one '|'-separated record per matching session, or return non-zero if the DAEMON COULD
# NOT BE ASKED. Those are different facts and the old code encoded both as "no session".
_sync_probe() {
  local sel
  sel=$(_sync_label_selector "$@")
  mutagen sync list --label-selector "$sel" --template "$RT_SYNC_TEMPLATE" 2>/dev/null
}

# The status verbs this classifier recognises, measured from Mutagen 0.18.1 (`strings` on the
# binary, cross-checked by driving each state on local endpoints).
#
# RT_SYNC_VERBS_OK are the states in which a session is doing its job — including
# `WaitingForRescan`, which is the ordinary gap between scans when no error accompanies it.
# `StagingAlpha` is listed alongside `StagingBeta` because only the latter appears as a
# standalone string in the binary and the pair is symmetric.
RT_SYNC_VERBS_OK="Watching Scanning WaitingForRescan Reconciling StagingAlpha StagingBeta Transitioning Saving"
# Mutagen's SAFETY BRAKES. Each stops synchronisation and waits for a human decision, and each
# was measured to carry an EMPTY .LastError with BOTH endpoints still `Connected: true` — which
# is why classifying on the error alone is not enough.
RT_SYNC_VERBS_HALTED="HaltedOnRootEmptied HaltedOnRootDeletion HaltedOnRootTypeChange"
RT_SYNC_VERBS_OFFLINE="Disconnected ConnectingAlpha ConnectingBeta"

# States: none | paused | halted | erroring | offline | active | unknown
#
# The classification is POSITIVE: a session is `active` only if its status verb is one this
# tool recognises as healthy. The old classifier was negative — it called anything `active` that
# did not match two strings — and the whole point of this entry is that a negative classifier
# has no way to be wrong about a state nobody thought of. An unrecognised verb (a future
# Mutagen adding a brake) now reports `unknown`, loudly, instead of `active`, silently.
#
# Two states carry facts the old one could not express:
#
#   halted    a safety brake. Measured 2026-08-05: all three Halted* verbs report an EMPTY
#             .LastError with both endpoints connected, so an error-only classifier calls them
#             healthy. Recovery is `mutagen sync reset` or reconciling the roots by hand — NOT
#             recreating the session.
#   erroring  a live .LastError under an otherwise-normal verb. The entry-count circuit breaker
#             lives here (`WaitingForRescan` + `exceeded allowed entry count`). Measured NOT
#             sticky: it clears within one rescan interval once the condition clears, so it is
#             a live condition rather than a scar — but it also does not clear by itself when
#             the cause is the ignore list, which is the case that actually happens.
#   unknown   the probe could not run, or answered ambiguously. Previously encoded as `none`,
#             i.e. "there is no sync session", a claim about the remote nothing established.
_sync_status() {
  local out rc=0
  out=$(_sync_probe "$@") || rc=$?
  if (( rc != 0 )); then echo unknown; return; fi

  local records
  records=$(grep -c . <<< "$out") || records=0
  if (( records == 0 )); then echo none; return; fi
  # One profile is one session. Two matching this label pair means something outside `rt`
  # created one, and picking the first would report a state over a scope not established.
  if (( records > 1 )); then echo unknown; return; fi

  local paused status aconn bconn scanned dirs files bytes lasterr
  IFS='|' read -r paused status aconn bconn scanned dirs files bytes lasterr <<< "$(grep -m1 . <<< "$out")"

  if [[ "$paused" == "true" ]]; then
    echo paused
  elif [[ " $RT_SYNC_VERBS_HALTED " == *" $status "* ]]; then
    echo halted
  elif [[ -n "$lasterr" ]]; then
    echo erroring
  elif [[ "$aconn" != "true" || "$bconn" != "true" ]]; then
    echo offline
  elif [[ " $RT_SYNC_VERBS_OFFLINE " == *" $status "* ]]; then
    echo offline
  elif [[ " $RT_SYNC_VERBS_OK " == *" $status "* ]]; then
    echo active
  else
    echo unknown
  fi
}

# The live error behind an `erroring` classification, for messages that have to say WHY.
_sync_last_error() {
  local out
  out=$(_sync_probe "$@") || return 1
  local line=""
  line=$(grep -m1 . <<< "$out") || true
  [[ -n "$line" ]] || return 1
  local paused status aconn bconn scanned dirs files bytes lasterr
  IFS='|' read -r paused status aconn bconn scanned dirs files bytes lasterr <<< "$line"
  printf '%s' "$lasterr"
}

# "<files> <bytes>" for the alpha endpoint, or non-zero if the size is NOT ESTABLISHED.
# `Scanned: false` means the counts describe nothing — a breaker-halted session reports
# `0|0|0` — so returning them as though they were a measurement would be the same fail-open
# this tool keeps closing: a zero that means "did not look" rendered as a zero that means
# "nothing there".
_sync_counts() {
  local out
  out=$(_sync_probe "$@") || return 1
  local line=""
  line=$(grep -m1 . <<< "$out") || true
  [[ -n "$line" ]] || return 1
  local paused status aconn bconn scanned dirs files bytes lasterr
  IFS='|' read -r paused status aconn bconn scanned dirs files bytes lasterr <<< "$line"
  [[ "$scanned" == "true" ]] || return 1
  printf '%s %s' "${files:-0}" "${bytes:-0}"
}

# True iff a session EXISTS. Derived from the one probe above rather than from a second,
# separately-broken grep: when the daemon cannot be asked this stays false, exactly as the old
# `|| true`-swallowed grep did, but now the reason is a state the caller can also read.
_has_sync() {
  local st
  st=$(_sync_status "$@")
  [[ "$st" != "none" && "$st" != "unknown" ]]
}

# Run a command with a wall-clock bound: kill it past $1 seconds and return 1.
# Mutagen daemon calls (flush, resume) can block indefinitely; every caller of
# this helper sits on the hot path of `rt exec`/`slurm submit`, so an unbounded
# call wedges EVERY command (even `echo` hangs).
_run_bounded() {
  local limit="$1"; shift
  "$@" >/dev/null 2>&1 &
  local pid=$!
  local waited=0
  while kill -0 "$pid" 2>/dev/null; do
    if (( waited >= limit )); then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      # 124, the conventional timeout(1) code, so callers can tell "did not finish in the
      # bound" from "the command itself failed". Those two need opposite handling: the first
      # means the daemon is still working, the second means nothing happened.
      return 124
    fi
    sleep 1
    waited=$((waited + 1))
  done
  wait "$pid"
}

# EXIT CODES, because "flush failed" was one word for two states that need OPPOSITE handling:
#
#   0  flushed — the remote has the local edits.
#   2  COULD NOT FLUSH. The session is paused, or mutagen itself errored. Nothing was
#      synchronised and nothing is going to be. A command run now sees whatever is there.
#   3  TIMED OUT at RT_FLUSH_TIMEOUT (default 10s). The daemon keeps syncing in the background,
#      so the edits are probably arriving; this call simply did not wait long enough.
#
# The distinction is load-bearing and was measured 2026-08-02: collapsing them meant every caller
# had to pick one policy for both, and the tool picked opposite ones — `exec` ran anyway, `slurm
# submit` aborted. Treating a 10s timeout on a big repo as fatal would make refusal so common
# that `--no-flush` becomes muscle memory, which turns the protection off entirely; treating a
# paused session as benign is how a GPU job runs yesterday's code.
# A courier bucket degrades SILENTLY as finished handoffs pile up, and by the time anyone looks
# the symptom is latency, not size. Measured 2026-08-01: 10,292 files / 2.6 GB in one bucket put
# a flush in `Scanning files` for 20+ minutes — a 9 KB push took ~40 minutes and a 2.7 MB pull
# had not arrived after 25 — while the same bucket at 232 files / 41 MB flushed in 7 seconds.
# Everything in it was FINISHED transfers nobody cleared.
#
# So: say the size BEFORE it becomes latency. Defaults sit between the two measurements and
# lean early, since the whole point is to warn before the stall.
#
# The standing lesson goes in the message, because the intuitive fix is the wrong one: a courier
# bucket needs PRUNING. A growing MUTAGEN_IGNORE is the tell that the bucket is being used as
# storage, and it does not even take effect until the session is recreated.
#
# RATE-LIMITED to once per RT_BLOAT_WARN_INTERVAL per profile. `rt exec` flushes on every call,
# and a warning printed hundreds of times is one that gets filtered — this workspace already has
# a caller that greps `^!! Sync flush` out of its output, which is what a noisy channel earns.
_sync_warn_if_bloated() {
  local counts files bytes
  counts=$(_sync_counts "$@") || return 0     # size not established -> claim nothing
  files="${counts%% *}"; bytes="${counts##* }"

  # `${VAR-default}`, NOT `${VAR:-default}`: the colon form substitutes the default for an
  # EMPTY value too, which would have made the documented escape hatch (`RT_SYNC_WARN_FILES=`)
  # silently do nothing. Caught by check 12i.
  local max_files="${RT_SYNC_WARN_FILES-2000}"
  local max_bytes="${RT_SYNC_WARN_BYTES-1073741824}"      # 1 GiB
  [[ -n "$max_files" && -n "$max_bytes" ]] || return 0    # set either empty to disable
  if (( files <= max_files )) && (( bytes <= max_bytes )); then return 0; fi

  local stamp="${RT_STATE_DIR}/bloat_warned" now=0 last=0
  now=$(date +%s)
  [[ -f "$stamp" ]] && last=$(cat "$stamp" 2>/dev/null || echo 0)
  [[ "$last" =~ ^[0-9]+$ ]] || last=0
  if (( now - last < ${RT_BLOAT_WARN_INTERVAL:-3600} )); then return 0; fi
  mkdir -p "$RT_STATE_DIR" 2>/dev/null && printf '%s' "$now" > "$stamp" 2>/dev/null || true

  warn "[$RT_PROFILE] Sync set is LARGE: ${files} files, $(( bytes / 1048576 )) MB. Flush latency grows with this, and it degrades quietly — measured, a bucket at ~10k files/2.6 GB stalled a flush for 20+ minutes while the same bucket at ~230 files flushed in 7 seconds."
  warn "[$RT_PROFILE] If this is a courier bucket, PRUNE it — a growing MUTAGEN_IGNORE is the tell that a sync bucket is being used as storage, and ignores do not take effect until the session is recreated anyway. Silence this with RT_SYNC_WARN_FILES= / RT_SYNC_WARN_BYTES=."
}

_sync_flush() {
  local sel
  sel=$(_sync_label_selector "$@")
  _sync_warn_if_bloated "$@"
  # Three states in which a flush CANNOT succeed, and returning 3 for any of them would be a
  # fail-open: `exec` continues on 3 (correctly — 3 means the daemon is still working), so a
  # session that is never going to converge would let a command run against stale code behind a
  # "still syncing" warning.
  #
  # `halted` is the one that motivated this. Measured 2026-08-05 against Mutagen 0.18.1: a
  # breaker-halted session does not fail a flush, it HANGS — `mutagen sync flush` was still
  # running after 15s with the session stuck in a rescan-fail loop. So before this, a halted
  # session burned the whole RT_FLUSH_TIMEOUT and reported 3, "the daemon is still syncing",
  # about a daemon that was making no progress and would make none until the ignore list is
  # fixed and the session RECREATED.
  local _st
  _st=$(_sync_status "$@")
  case "$_st" in
    paused)
      warn "Sync session is PAUSED — flush skipped. 'rt -p ${RT_PROFILE} connect' resumes it."
      return 2 ;;
    halted)
      warn "Sync session is HALTED by a Mutagen safety brake and is synchronising nothing. Flush skipped."
      warn "This one needs a human decision — it fires when a root was emptied, deleted, or changed type, and resuming propagates that. Inspect with 'rt -p ${RT_PROFILE} sync status'; recover with 'mutagen sync reset --label-selector=\"$(_sync_label_selector "$@")\"' once you know which side is right. Do NOT recreate the session to clear it."
      return 2 ;;
    erroring)
      warn "Sync session has a live error and is synchronising nothing: $(_sync_last_error "$@")"
      warn "Flush skipped (it would hang, not fail). If this is the entry-count breaker: fix MUTAGEN_IGNORE or raise MUTAGEN_MAX_ENTRY_COUNT, then 'rt -p ${RT_PROFILE} disconnect && rt -p ${RT_PROFILE} connect' — ignores only apply at session-create time, so editing them does nothing to a live session."
      return 2 ;;
    unknown)
      warn "Could not ask the Mutagen daemon for this session's state, so nothing establishes that a flush would do anything. Check 'mutagen daemon start' and 'rt -p ${RT_PROFILE} sync status'."
      return 2 ;;
  esac
  # Bound the wait. `mutagen sync flush` blocks until the daemon finishes one
  # full sync cycle, which on a large or backlogged session takes minutes.
  # The daemon keeps syncing in the background regardless, so past the cap we
  # lose at most the "remote sees newest edits" guarantee (caller warns on
  # non-zero). Tune via RT_FLUSH_TIMEOUT (seconds). A flush that routinely
  # times out usually means the profile is missing MUTAGEN_IGNORE entries for
  # a heavy dir (bloated sync set). For read-only monitoring (no local edits to
  # push — e.g. a CVM grep/stat/cat) prefer 'rt exec --no-flush' to skip it.
  local rc=0
  _run_bounded "${RT_FLUSH_TIMEOUT:-10}" mutagen sync flush --label-selector "$sel" || rc=$?
  case "$rc" in
    0)   return 0 ;;
    124) return 3 ;;   # the bound, not a failure of the sync itself
    *)   return 2 ;;   # mutagen said no
  esac
}

# Resume a paused session. Bounded like flush; resume re-establishes the SSH
# transport, so the default cap is wider (RT_RESUME_TIMEOUT, seconds).
_sync_resume() {
  local sel
  sel=$(_sync_label_selector "$@")
  _run_bounded "${RT_RESUME_TIMEOUT:-60}" mutagen sync resume --label-selector "$sel"
}

# Echo mutagen's own message and return ITS status. The `>/dev/null 2>&1 || true` that used to
# be here discarded every failure, and `disconnect` went on to delete the local record and print
# "Disconnected" over a session that was still running and still propagating deletions.
_sync_terminate() {
  local sel
  sel=$(_sync_label_selector "$@")
  mutagen sync terminate --label-selector "$sel" 2>&1
}

# THE DEFAULT SYNC SCOPE. Documented in SKILL.md and README.md; those lists and this one have
# to be read together, because everything here is a path whose contents NEVER reach the local
# replica — a result written to `outputs/` or `checkpoints/` on the remote does not come back,
# and nothing in the tool said so.
RT_DEFAULT_IGNORES=(
  "__pycache__/" "*.pyc" ".venv/" "venv/" "node_modules/"
  "wandb/" "outputs/" "checkpoints/" ".ipynb_checkpoints/"
  ".triton_cache/" ".DS_Store" "*.swp"
  # Personal / Claude Code harness artifacts. These are LOCAL reasoning aids,
  # never project deliverables, and must not mirror onto the (often SHARED)
  # remotes — nor leak into repos that get pushed from the box. Bare names match
  # at any depth; trailing slash = directory. Bench scaffolding
  # (bench.py/bench_runner/conftest/bench.sh) is deliberately NOT here — it must
  # run on the remote GPU.
  ".claude/" "CLAUDE.md" "HANDOFF.md" "HINTS.md" "ITERATIONS.md"
  ".local/" "*.local.md"
)

# The ignore set a session created RIGHT NOW would carry: defaults, then the profile's extras.
# Shared by `_sync_create` and by the drift check in `sync status`, so the two cannot disagree
# about what the current config means.
_ignore_patterns() {
  printf '%s\n' "${RT_DEFAULT_IGNORES[@]}"
  if [[ -n "${MUTAGEN_IGNORE+x}" ]]; then
    printf '%s\n' "${MUTAGEN_IGNORE[@]}"
  fi
}

# The ignore set the LIVE session is actually enforcing. Mutagen freezes ignores at session
# CREATE time, so this and `_ignore_patterns` drift apart the moment someone edits a config —
# and the config is what everyone reads when asking "why did this file not come back?".
_sync_live_ignores() {
  local sel
  sel=$(_sync_label_selector "$@")
  mutagen sync list --label-selector "$sel" \
    --template '{{range .}}{{range .Configuration.Ignore.Paths}}{{.}}
{{end}}{{end}}' 2>/dev/null
}

# Whether the live session ignores VCS directories (`.git/`). Same freezing applies.
_sync_live_vcs() {
  local sel
  sel=$(_sync_label_selector "$@")
  mutagen sync list --label-selector "$sel" \
    --template '{{range .}}{{.Configuration.Ignore.VCS}}{{end}}' 2>/dev/null
}

_sync_create() {
  local session_name
  session_name=$(_sync_session_name)
  local mutagen_url="${REMOTE_HOST}:${REMOTE_DIR}"

  local sync_mode="${MUTAGEN_SYNC_MODE:-two-way-resolved}"

  local args=(
    --name="${session_name}"
    --label="rt-host=${RT_HOST_GROUP}"
    --label="rt-profile=${RT_PROFILE_NAME}"
    --mode="${sync_mode}"
  )

  if [[ "${MUTAGEN_IGNORE_VCS:-1}" == "1" ]]; then
    args+=(--ignore-vcs)
  fi

  local pat
  while IFS= read -r pat; do
    [[ -n "$pat" ]] && args+=("--ignore=${pat}")
  done < <(_ignore_patterns)

  # Circuit breaker (blast-radius cap). All profiles share ONE Mutagen daemon and
  # (per host) one filesystem mount, so a single profile syncing a runaway tree — a
  # heavy dir missing from MUTAGEN_IGNORE — can saturate the daemon's scan/reconcile
  # loop and wedge EVERY other profile's auto-flush (even `echo` hangs). A
  # --max-entry-count makes such a session HALT ITSELF (loud + local) instead of
  # taking the shared daemon down with it. It BACKSTOPS MUTAGEN_IGNORE hygiene, it
  # does not replace it: on slow ceph-fuse remotes even a few-thousand-file dir hurts
  # well below this cap, so tighten per host via MUTAGEN_MAX_ENTRY_COUNT in host.conf.
  # Raise it for a profile that legitimately manages more; set it empty to disable.
  # --max-staging-file-size (opt-in) caps individual staged files.
  local max_entries="${MUTAGEN_MAX_ENTRY_COUNT-50000}"
  [[ -n "$max_entries" ]] && args+=(--max-entry-count="$max_entries")
  [[ -n "${MUTAGEN_MAX_STAGING_FILE_SIZE:-}" ]] && args+=(--max-staging-file-size="$MUTAGEN_MAX_STAGING_FILE_SIZE")

  mutagen sync create "${args[@]}" "${LOCAL_DIR}" "${mutagen_url}"
}

# ── Config ─────────────────────────────────────────────────────────
load_config() {
  _require_profile
  [[ -f "$RT_CONF" ]] || die "Config not found: $RT_CONF
  Run 'rt -p ${RT_HOST_GROUP}/${RT_PROFILE_NAME} init' to create from template, or create manually in ${RT_HOME}/${RT_HOST_GROUP}/"

  # Source host-level config first (shared across profiles in this host group),
  # then profile-specific config (its values override host-level).
  if [[ -f "$RT_HOST_CONF" ]]; then
    # shellcheck source=/dev/null
    . "$RT_HOST_CONF"
  fi
  # shellcheck source=/dev/null
  . "$RT_CONF"

  [[ -n "${REMOTE_HOST:-}" ]] || die "REMOTE_HOST not set in $RT_HOST_CONF or $RT_CONF"
  [[ -n "${REMOTE_DIR:-}" ]]  || die "REMOTE_DIR not set in $RT_CONF"
  # Most REMOTE_DIR interpolations are single-quote encoded, but `exec --bg` embeds it three
  # quoting levels deep inside a tmux argument, where an apostrophe cannot be carried safely.
  # Refusing it here turns what used to be a silently malformed remote command into a clear
  # local error.
  [[ "$REMOTE_DIR" != *"'"* ]] \
    || die "REMOTE_DIR contains a single quote, which cannot be carried safely into the background-exec payload: $REMOTE_DIR"

  # Default local replica dir: ~/Work/Remote/<host-group>/<profile-name>/
  LOCAL_DIR="${LOCAL_DIR:-$HOME/Work/Remote/${RT_HOST_GROUP}/${RT_PROFILE_NAME}}"
  SSH_PORT="${SSH_PORT:-22}"
  SSH_KEY="${SSH_KEY:-}"
  SLURM_ENABLED="${SLURM_ENABLED:-0}"
  SLURM_LOG_DIR="${SLURM_LOG_DIR:-$REMOTE_DIR}"
  SLURM_SBATCH_ARGS="${SLURM_SBATCH_ARGS:-}"

  # Build shared SSH options array (used by direct _ssh calls; Mutagen uses ~/.ssh/config)
  SSH_OPTS=(
    -o ConnectTimeout=10
    -o BatchMode=yes
    -o ServerAliveInterval=30
    -o ServerAliveCountMax=3
    -p "$SSH_PORT"
  )
  if [[ -n "$SSH_KEY" ]]; then SSH_OPTS+=(-i "$SSH_KEY"); fi
}

# ── State helpers ──────────────────────────────────────────────────
save_state() {
  mkdir -p "$RT_STATE_DIR"
  printf '%s' "$REMOTE_HOST"           > "$RT_STATE_DIR/host"
  printf '%s' "$LOCAL_DIR"             > "$RT_STATE_DIR/local_dir"
  printf '%s' "$REMOTE_DIR"            > "$RT_STATE_DIR/remote_dir"
  printf '%s' "$RT_PROFILE"            > "$RT_STATE_DIR/profile"
  printf '%s' "$(_sync_session_name)"  > "$RT_STATE_DIR/sync_session"
}

clear_state() {
  # Slurm submission history is the only LOCAL record of what was queued, and it has nothing to
  # do with whether a sync session exists — deleting it on disconnect destroyed the one artifact
  # you would go looking for afterwards. It is preserved; everything else (connection state) is
  # rebuilt by the next `rt connect`.
  local keep=""
  if [[ -e "$RT_STATE_DIR/slurm_jobs" ]]; then
    keep=$(mktemp -d)
    cp -R "$RT_STATE_DIR/slurm_jobs" "$keep/" 2>/dev/null || keep=""
  fi
  rm -rf "$RT_STATE_DIR"
  if [[ -n "$keep" && -e "$keep/slurm_jobs" ]]; then
    mkdir -p "$RT_STATE_DIR"
    cp -R "$keep/slurm_jobs" "$RT_STATE_DIR/" 2>/dev/null || true
    rm -rf "$keep"
  fi
}

# ── The remote-shell trust boundary ────────────────────────────────────────────
#
# `_ssh` hands a STRING to a remote login shell, so every value interpolated into that string is
# shell source unless something makes it data. Agent-supplied ids and names are the boundary that
# matters — config files are sourced bash and are already trusted — and the failure was that
# `slurm cancel` interpolated its arguments straight into `scancel $*`, so
# `rt slurm cancel '123; some-command'` built a remote compound command. Log ids reached
# `tail -f ~/.rt_logs/<id>.log` unquoted for the same reason.
#
# Two controls, because one does not cover every site:
#   _shq            POSIX single-quote encoding, for the sites where a quoted word is enough.
#   _require_*      a grammar, for values that also flow into places quoting cannot reach —
#                   notably the `exec --bg` payload, which nests three levels of quoting inside
#                   a tmux argument inside an ssh argument.

# Encode $1 as a single POSIX shell word. `'` becomes `'\''`; everything else is inert inside
# single quotes, including $, `, ;, newline and backslash. Verified to round-trip under dash as
# well as bash — the remote runs a LOGIN shell, which is not necessarily bash.
_shq() {
  local s="$1"
  s=${s//"'"/"'\\''"}
  printf "'%s'" "$s"
}

# A Slurm job id is never a shell fragment. Accepts 12345, an array task 12345_7, and an array
# range 12345_[1-9] — the forms scancel/sacct actually take — and nothing else.
_require_jobid() {
  [[ "$1" =~ ^[0-9]+(_([0-9]+|\[[0-9]+(-[0-9]+)?\]))?$ ]] \
    || die "Not a Slurm job id: '$1'. Expected 12345, 12345_7 or 12345_[1-9]. Job ids are data, not shell."
}

# Background-job names, and the session ids derived from them. This one is a GRAMMAR rather than
# a quoting rule because the value is interpolated into the `exec --bg` payload, where it sits
# inside a tmux argument inside an ssh argument and correct quoting through all three layers is
# far more fragile than refusing the characters outright.
_require_jobname() {
  [[ "$1" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] \
    || die "Invalid job name '$1'. Use letters, digits, '.', '_' and '-', starting with a letter or digit."
}

_ssh() {
  ssh "${SSH_OPTS[@]}" "$REMOTE_HOST" "$@"
}

_ssh_test() {
  _ssh "echo ok" >/dev/null 2>&1
}

# ── Subcommands ────────────────────────────────────────────────────

cmd_check() {
  local ok=true
  printf 'Checking dependencies ...\n\n'

  # Format: command|package|missing_note|alt_command
  local deps=(
    "ssh|ssh||"
    "tmux|tmux||"
    "mutagen|mutagen||"
    "sshpass|sshpass|needed for rt setup-key --password|"
  )

  for entry in "${deps[@]}"; do
    IFS='|' read -r cmd pkg note alt <<< "$entry"
    if command -v "$cmd" >/dev/null 2>&1; then
      info "$cmd — OK ($(command -v "$cmd"))"
    elif [[ -n "$alt" ]] && command -v "$alt" >/dev/null 2>&1; then
      info "$cmd — OK ($(command -v "$alt"))"
    else
      local label="MISSING"
      [[ -n "$note" ]] && label="MISSING ($note)"
      warn "$cmd — $label"
      [[ -n "$pkg" ]] && printf '  Install: %s\n' "$(_install_hint "$pkg")"
      ok=false
    fi
  done

  printf '\n'
  if [[ "$ok" == true ]]; then
    info "All dependencies satisfied."
  else
    warn "Some dependencies are missing. Ask the user to run the install commands above."
  fi
  [[ "$ok" == true ]]
}

cmd_init() {
  _require_profile
  mkdir -p "${RT_HOME}/${RT_HOST_GROUP}"

  # Host-level config: REMOTE_HOST + SSH params shared by all profiles in this host group
  if [[ ! -f "$RT_HOST_CONF" ]]; then
    cat > "$RT_HOST_CONF" <<'TMPL'
# Host-level config (shared by all profiles in this host group)
REMOTE_HOST="user@example.com"
# SSH_PORT=22
# SSH_KEY="$HOME/.ssh/id_ed25519"
# SLURM_ENABLED=0
TMPL
    info "Created $RT_HOST_CONF (host-level)."
  else
    info "Host config already exists: $RT_HOST_CONF"
  fi

  # Profile config: workspace-specific REMOTE_DIR + LOCAL_DIR
  if [[ ! -f "$RT_CONF" ]]; then
    cat > "$RT_CONF" <<'TMPL'
# Profile config (workspace-specific; overrides host.conf)
REMOTE_DIR="/home/user/project"
# LOCAL_DIR="$HOME/Work/Remote/<host>/<profile>"
# MUTAGEN_SYNC_MODE="two-way-resolved"
# MUTAGEN_IGNORE_VCS=1
# MUTAGEN_IGNORE=("data/")
# SLURM_LOG_DIR="$REMOTE_DIR"
TMPL
    info "Created $RT_CONF (profile)."
  else
    info "Profile config already exists: $RT_CONF"
  fi

  info "Host-group dir: ${RT_HOME}/${RT_HOST_GROUP}/"
  info "Next: edit configs, then run 'rt -p ${RT_HOST_GROUP}/${RT_PROFILE_NAME} connect'"
}

cmd_setup_key() {
  load_config

  # Parse flags
  local password=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --password)   password="$2"; shift 2 ;;
      --password=*) password="${1#--password=}"; shift ;;
      *)            die "Usage: rt setup-key [--password PASSWORD]" ;;
    esac
  done

  # Determine which key to copy
  local key_file="${SSH_KEY:-}"
  if [[ -z "$key_file" ]]; then
    for k in "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_rsa"; do
      if [[ -f "$k" ]]; then key_file="$k"; break; fi
    done
  fi
  [[ -n "$key_file" && -f "$key_file" ]] || die "No SSH key found. Generate one: ssh-keygen -t ed25519"
  [[ -f "${key_file}.pub" ]] || die "Public key not found: ${key_file}.pub"

  info "[$RT_PROFILE] Copying ${key_file}.pub → $REMOTE_HOST (port $SSH_PORT)"

  if [[ -n "$password" ]]; then
    # Non-interactive: use sshpass
    command -v sshpass >/dev/null 2>&1 \
      || die "sshpass not found. Ask the user to install: $(_install_hint sshpass)"
    SSHPASS="$password" sshpass -e ssh-copy-id \
      -o StrictHostKeyChecking=accept-new \
      -i "$key_file" -p "$SSH_PORT" "$REMOTE_HOST"
  else
    # Interactive: prompt for password
    info "You will be prompted for the remote password (one time only)."
    ssh-copy-id -i "$key_file" -p "$SSH_PORT" "$REMOTE_HOST"
  fi

  # Verify key auth works
  info "Verifying key authentication ..."
  if _ssh_test; then
    info "Key auth works! You can now use: rt connect"
  else
    die "Key was copied but verification failed. Check server sshd_config."
  fi
}

cmd_connect() {
  load_config
  _mutagen_check
  _mutagen_daemon_ensure

  # One probe, then act on what it says.
  local _st
  _st=$(_sync_status)

  # Checked BEFORE the has-session branch: when the daemon cannot be asked, "there is no
  # session" is not established, and creating a SECOND session for a profile that already has
  # one is worse than stopping. (The old code could not tell these apart at all — a failed
  # `mutagen sync list` read as "no session" and fell straight through to create.)
  if [[ "$_st" == "unknown" ]]; then
    die "[$RT_PROFILE] Could not ask the Mutagen daemon whether this profile already has a session, so connecting now might create a second one. Check 'mutagen daemon start', then retry."
  fi

  # Idempotent: sync session already exists → resume if paused, flush, exit
  if [[ "$_st" != "none" ]]; then
    # Resume is for PAUSED sessions. Neither of these is paused, so resuming is a no-op that
    # used to be followed by "Already connected" — a success line over a session synchronising
    # nothing. Say plainly that connect cannot fix it, and give the REMEDY THAT MATCHES, which
    # differs between the two: a safety brake is a decision about which side is right, and
    # recreating the session to clear it would answer that question by accident.
    if [[ "$_st" == "halted" ]]; then
      die "[$RT_PROFILE] Sync session is HALTED by a Mutagen safety brake (a root was emptied, deleted, or changed type) and 'connect' must not clear it — that would decide, silently, which side's contents win. Inspect with 'rt -p $RT_PROFILE sync status', then recover deliberately with 'mutagen sync reset --label-selector=\"$(_sync_label_selector)\"' or by reconciling the roots by hand."
    fi
    if [[ "$_st" == "erroring" ]]; then
      warn "[$RT_PROFILE] Sync session has a live error: $(_sync_last_error)"
      die "[$RT_PROFILE] 'connect' cannot recover it — it is not paused, so there is nothing to resume, and it is synchronising nothing. If this is the entry-count breaker, fix the cause (usually a heavy dir missing from MUTAGEN_IGNORE; or raise MUTAGEN_MAX_ENTRY_COUNT), then recreate: 'rt -p $RT_PROFILE disconnect && rt -p $RT_PROFILE connect'. Editing MUTAGEN_IGNORE alone does nothing — ignores only apply at session-create time."
    fi
    if [[ "$_st" == "paused" ]]; then
      info "[$RT_PROFILE] Sync session is paused — resuming ..."
      _sync_resume || die "Resume failed. Diagnose with 'rt -p $RT_PROFILE sync status' — a session halted by the entry-count circuit breaker records the error there; fix MUTAGEN_IGNORE (or raise MUTAGEN_MAX_ENTRY_COUNT) before retrying."
    fi
    info "[$RT_PROFILE] Already connected to $REMOTE_HOST (flushing pending changes)"
    _crc=0
    _sync_flush || _crc=$?
    case "$_crc" in
      2) warn "[$RT_PROFILE] Could NOT flush (paused session or a mutagen error) — the remote does not have your latest edits. 'rt sync status' says why." ;;
      3) warn "[$RT_PROFILE] Flush did not finish within ${RT_FLUSH_TIMEOUT:-10}s; the daemon is still syncing." ;;
    esac
    cmd_status
    return 0
  fi

  # Test SSH connectivity
  info "[$RT_PROFILE] Testing SSH connection to $REMOTE_HOST ..."
  if ! _ssh_test; then
    die "Cannot reach $REMOTE_HOST via SSH. If using password auth, run 'rt setup-key' first."
  fi

  # Verify remote directory exists
  if ! _ssh "test -d $(_shq "$REMOTE_DIR")"; then
    die "Remote directory does not exist: $REMOTE_DIR"
  fi

  # Warn on non-default ssh params (Mutagen uses ~/.ssh/config, not SSH_OPTS)
  if [[ "$SSH_PORT" != "22" ]] || [[ -n "$SSH_KEY" ]]; then
    warn "Non-default SSH_PORT or SSH_KEY detected."
    warn "Mutagen uses ~/.ssh/config for SSH parameters. Add an entry like:"
    warn "  Host ${REMOTE_HOST#*@}"
    [[ "$SSH_PORT" != "22" ]] && warn "    Port ${SSH_PORT}"
    [[ -n "$SSH_KEY" ]]       && warn "    IdentityFile ${SSH_KEY}"
    warn "Otherwise sync may fail with 'connection refused' or auth errors."
  fi

  # Create local replica directory
  mkdir -p "$LOCAL_DIR"

  # Create Mutagen sync session
  info "[$RT_PROFILE] Starting sync: $LOCAL_DIR ⇄ $REMOTE_HOST:$REMOTE_DIR ..."
  if ! _sync_create; then
    die "Mutagen sync create failed. Check 'mutagen sync list' for diagnostics."
  fi

  save_state
  info "[$RT_PROFILE] Connected!"
  info "  Local:    $LOCAL_DIR (auto-syncs in background)"
  info "  Remote:   $REMOTE_HOST:$REMOTE_DIR"
  info "  Session:  $(_sync_session_name)"
  info "  Status:   rt -p $RT_PROFILE status"
}

cmd_disconnect() {
  load_config

  local kill_jobs=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --kill-jobs) kill_jobs=true; shift ;;
      *) die "Usage: rt disconnect [--kill-jobs]" ;;
    esac
  done

  # DISCONNECTING THE SYNC AND KILLING YOUR JOBS ARE TWO DIFFERENT INTENTIONS, and this used to
  # do both under the name of the first. README and SKILL.md both said disconnect terminates
  # sync and preserves work; the code killed every tmux session matching the profile prefix,
  # with no flush before or after, so a running training job was interrupted and its last
  # buffered output could never reach local. Found 2026-08-02 by this tool's first audit.
  #
  # Default is now the documented behaviour. `--kill-jobs` is the deliberate "I am done, clean
  # up" form, and it FLUSHES FIRST so that whatever the jobs have already written comes back
  # before they are killed.
  if [[ "$kill_jobs" == true ]]; then
    if _ssh_test; then
      if _has_sync; then
        info "[$RT_PROFILE] Flushing before killing jobs (their output would otherwise be lost) ..."
        _sync_flush || warn "[$RT_PROFILE] Could not flush before killing jobs — output written since the last sync may be lost."
      fi
      info "[$RT_PROFILE] Killing remote background jobs ..."
      _ssh \
        "tmux list-sessions -F '#{session_name}' 2>/dev/null \
         | grep '^${RT_SESSION_PREFIX}' \
         | xargs -I{} tmux kill-session -t {} 2>/dev/null" \
        2>/dev/null || true
    fi
  elif _ssh_test; then
    # Say what is being LEFT RUNNING. Silence here reads as "nothing was running".
    local _left
    _left=$(_ssh "tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -c '^${RT_SESSION_PREFIX}'" 2>/dev/null | tr -d '[:space:]') || _left=""
    if [[ -n "$_left" && "$_left" != "0" ]]; then
      info "[$RT_PROFILE] Leaving ${_left} background job(s) RUNNING on $REMOTE_HOST (they no longer sync back). 'rt disconnect --kill-jobs' stops them; 'rt connect' resumes syncing."
    fi
  fi

  # `disconnect` used to report success whether or not termination worked, and delete the local
  # record either way: `mutagen sync terminate … || true` discarded the failure, `clear_state`
  # ran unconditionally, and `Disconnected` was printed with rc 0. The session could still be
  # running — still propagating deletions — with the only local trace of it gone.
  #
  # The state directory is now deleted ONLY after termination is established, and "established"
  # means re-asking the daemon, not trusting the exit code of the command that was supposed to
  # do it.
  local _st
  _st=$(_sync_status)
  case "$_st" in
    unknown)
      die "[$RT_PROFILE] Could not ask the Mutagen daemon whether a sync session exists, so this cannot terminate one and must not delete the local record of it. Local state left intact. Check 'mutagen daemon start', then retry." ;;
    none)
      info "[$RT_PROFILE] No active sync session." ;;
    *)
      info "[$RT_PROFILE] Terminating sync session $(_sync_session_name) ..."
      local _terr="" _trc=0
      _terr=$(_sync_terminate) || _trc=$?
      if (( _trc != 0 )); then
        [[ -n "$_terr" ]] && warn "[$RT_PROFILE] mutagen: $_terr"
        die "[$RT_PROFILE] Sync session termination FAILED (mutagen exit $_trc). The session may still be running and propagating deletions. Local state has NOT been cleared, so the record of it survives — inspect with 'rt -p $RT_PROFILE sync status'."
      fi
      # The exit code says the command succeeded; this says the session is gone. They are
      # different claims, and this command's whole job is the second one.
      #
      # `_has_sync` is NOT the right instrument here: it is a boolean and collapses "there is no
      # session" with "I could not ask", so a daemon that became unaskable between the terminate
      # and this check read as proof of termination — and the local record was then deleted over
      # a session that may still exist. Found by an independent review of this session's own fix.
      local _post
      _post=$(_sync_status)
      case "$_post" in
        none) : ;;   # established: it is gone
        unknown)
          die "[$RT_PROFILE] mutagen reported success, but the daemon could not then be asked whether the session is actually gone — so termination is NOT established. Local state has NOT been cleared. Inspect with 'rt -p $RT_PROFILE sync status'." ;;
        *)
          die "[$RT_PROFILE] mutagen reported success but the sync session is still present (state: $_post). Local state has NOT been cleared. Inspect with 'rt -p $RT_PROFILE sync status'." ;;
      esac ;;
  esac

  clear_state
  info "[$RT_PROFILE] Disconnected. Local replica preserved at $LOCAL_DIR"
}

cmd_exec() {
  load_config

  # Parse flags
  local bg=false
  local name=""
  local no_flush=false
  local timeout_s=""
  local cmd_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --bg)        bg=true; shift ;;
      --name)      name="$2"; shift 2 ;;
      --name=*)    name="${1#--name=}"; shift ;;
      --no-flush)  no_flush=true; shift ;;
      --timeout)   timeout_s="$2"; shift 2 ;;
      --timeout=*) timeout_s="${1#--timeout=}"; shift ;;
      --)          shift; cmd_args+=("$@"); break ;;
      -*)          die "Unknown flag: $1" ;;
      *)           cmd_args+=("$@"); break ;;
    esac
  done

  [[ ${#cmd_args[@]} -gt 0 ]] || die "Usage: rt exec [--bg] [--name NAME] [--no-flush] [--timeout SECS] <command>"

  if [[ -n "$timeout_s" ]]; then
    [[ "$timeout_s" =~ ^[1-9][0-9]*$ ]] \
      || die "--timeout takes whole seconds greater than zero, got '$timeout_s'."
    # A background job is unbounded BY DESIGN — that is what --bg is for — so bounding it would
    # only ever kill the ssh that launched tmux, which says nothing about the job.
    [[ "$bg" == false ]] || die "--timeout and --bg are contradictory: a background job outlives this shell. Use 'rt logs' to check on it."
  fi

  # Need SSH; sync state is independent
  _ssh_test || die "[$RT_PROFILE] Cannot reach $REMOTE_HOST. Run 'rt connect' first."

  # Auto-flush sync so the remote sees latest edits before exec.
  #
  # The gate used to be `_has_sync`, a BOOLEAN, and a boolean cannot carry "I could not find
  # out". When the daemon could not be asked, `_has_sync` was false, the whole block was
  # skipped, and the command ran with no flush and no warning — the most permissive path taken
  # for the least established state, which is the same fail-open `slurm submit` had for "no
  # session at all". Found by an independent review of this session's own change.
  if [[ "$no_flush" == false ]]; then
    local _sst
    _sst=$(_sync_status)
    if [[ "$_sst" == "unknown" ]]; then
      die "[$RT_PROFILE] Could not establish whether this profile has a sync session (the Mutagen daemon could not be asked, or answered ambiguously), so nothing establishes that the remote has your latest edits. Check 'mutagen daemon start' and 'rt -p $RT_PROFILE sync status', or pass --no-flush if you intend to run against the remote as it stands."
    fi
  fi

  if [[ "$no_flush" == false ]] && _has_sync; then
    # 2 = nothing synchronised. Running now would execute whatever code happens to be on the
    # remote, and the caller — usually a script or an agent branching on $? — would be told the
    # command succeeded. That is how a GPU job silently runs yesterday's code. 3 = the 10s bound
    # elapsed while the daemon kept working; the edits are probably arriving, so it continues,
    # but it says WHAT it could not establish rather than "had issues".
    local _frc=0
    _sync_flush || _frc=$?
    case "$_frc" in
      2) die "[$RT_PROFILE] Sync could NOT be flushed (paused session or a mutagen error), so the remote may not have your latest edits and this command would run against unknown code. Fix with 'rt -p $RT_PROFILE connect', or pass --no-flush if you intend to run against the remote as it stands." ;;
      3) warn "[$RT_PROFILE] Flush did not finish within ${RT_FLUSH_TIMEOUT:-10}s — the daemon is still syncing, so this command may see slightly older files. Raise RT_FLUSH_TIMEOUT, or add the heavy dir to MUTAGEN_IGNORE." ;;
    esac
  fi

  local command="${cmd_args[*]}"
  if [[ "$bg" == true ]]; then
    _exec_bg "$command" "$name"
  else
    _exec_sync "$command" "$timeout_s"
  fi
}

# ── What `exec` actually delivered ─────────────────────────────────────────────
#
# A stream carries no statement about its own completeness: a caller that receives half of one
# receives no signal that it is half. Measured by a project doing a multi-file pull through a
# single `exec` — 1 of 7 files arrived and the call still exited 0. The loss was caught only
# because that caller happened to hold a manifest of what it had asked for; an agent doing the
# same pull without one cannot detect it at all.
#
# The defect is the SILENCE, not any particular cap — and note where the cap is NOT: nothing in
# this script limits the payload, and ssh does not truncate, so the cut happens in whatever
# captures rt's stdout. `rt` cannot prevent that. What it can do is make the two facts a caller
# would need in order to notice checkable:
#
#   · a TRAILER, written to stderr by the remote shell only AFTER the command has exited. Its
#     arrival is evidence that the whole of that command's stdout was written to the channel;
#     its absence means the stream ended early, and that case used to exit 0 and say nothing.
#   · the payload is COUNTED as it passes through, and the count is reported once it is large
#     enough for a downstream capture limit to be plausible. That number is what a caller
#     compares against what it actually holds.
#
# Both are additive. stdout stays a byte-exact pass-through — a live caller pipes `tar cf -`
# through `exec` into `tar xf -`, so one added byte would corrupt an archive — and an output
# below the report threshold produces exactly what it produced before.
#
# Raising a limit is explicitly not the fix: the next payload is always bigger than the new cap.
# Routing large payloads to a file and returning the path is the larger fix, and is a contract
# change rather than this.

# The text the remote login shell runs. The command goes in a SUBSHELL for the same reason
# `_exec_bg` uses one: a command that is literally `exit N` would otherwise terminate the shell
# before the trailer is written, and since the trailer's absence is this function's failure
# signal, `rt exec 'exit 7'` would report a truncated stream that was never truncated.
#
# CORRECTION, from a mutation run on this commit's own first claim: the trailing `exit` was
# described here as what keeps `exec`'s status the command's rather than printf's. It is not —
# `_exec_account` reads the status out of the TRAILER, so removing this line changes no result
# and the suite stayed green with it gone. It earns its place for a narrower reason: it keeps
# ssh's own status agreeing with the trailer's, which is what the accounting falls back to when
# the trailer is absent or malformed.
_exec_remote_cmd() {  # <token> <command>
  local token="$1" command="$2"
  # $command is deliberately shell text — that is what `rt exec` is for. REMOTE_DIR is not.
  cat <<EOF
cd $(_shq "$REMOTE_DIR") && ( ${command} )
__rt_rc=\$?
printf '%s%s\n' $(_shq "$token") "\$__rt_rc" >&2
exit \$__rt_rc
EOF
}

# Pass the remote's stderr through, minus the trailer, whose status is written to <rcfile>.
#
# The token is a per-invocation nonce, so any record carrying it is ours and no line has to be
# held back to find out — holding one back would delay a long-running command's progress output
# by a line, which is a behaviour change. `fflush` is there for the same reason: awk block-buffers
# when its output is not a terminal, and `exec`'s stderr is watched live.
#
# `pre` covers the one case where the trailer is not a record of its own: a remote whose last
# stderr write had no trailing newline. That prefix is re-emitted with one, which is the only byte
# this filter can add, and only on stderr.
_exec_trailer_filter() {  # <token> <rcfile>
  awk -v t="$1" -v f="$2" '
    {
      i = index($0, t)
      if (i > 0) {
        pre = substr($0, 1, i - 1)
        if (pre != "") { printf "%s\n", pre; fflush() }
        rc = substr($0, i + length(t))
        if (rc ~ /^[0-9]+$/) { printf "%s\n", rc > f; close(f) }
        next
      }
      print; fflush()
    }'
}

# Wait for the accounting readers, but not without a bound of its own. `--timeout`'s promise is
# that the CALLER stops waiting, and the readers only see EOF once EVERY holder of the payload
# pipe's write end has closed it — which after a kill can include something ssh left behind. Found
# by this repo's own `--timeout` check the moment the accounting was added: against a stub whose
# `sleep` outlived the killed ssh, a 1s bound returned after 4s.
#
# Past the grace the readers are KILLED and, because `wc` writes its total only at EOF, the byte
# count is then simply absent. That is reported as unestablished, never as 0: a count that could
# not be taken is not a small one.
_exec_reap() {  # <grace-seconds> <pid>...
  local grace="$1"; shift
  local waited=0 p alive
  while [[ "$waited" -lt "$grace" ]]; do
    alive=0
    for p in "$@"; do kill -0 "$p" 2>/dev/null && alive=1; done
    [[ "$alive" -eq 0 ]] && return 0
    sleep 1
    waited=$((waited + 1))
  done
  for p in "$@"; do kill "$p" 2>/dev/null || true; done
  return 1
}

# Say what was established about the stream, in the order the facts are decided.
#
# <trailer-rc> empty means the trailer never arrived — the stream ended before the command did.
# <bytes> empty means the count could not be taken. <forward-rc> is the PASS-THROUGH's own status,
# and it is the second way this can fail: the trailer proves the command wrote everything it had,
# and says nothing about whether rt managed to hand all of it on. Found by probing this commit's
# own change — `exec 'cat 400KB' | head -c 5` reported "81920 bytes of stdout, complete", which is
# the exact shape of unsupported benign claim the change exists to remove, reintroduced one layer
# out.
_exec_account() {  # <bytes-or-empty> <trailer-rc-or-empty> <transport-rc> <forward-rc>
  local bytes="$1" trailer="$2" transport="$3" forward="$4"
  local report="${RT_EXEC_REPORT_BYTES:-65536}"
  local seen="an unestablished number of bytes"
  [[ -n "$bytes" ]] && seen="$bytes bytes"

  # The bound is decided first, and on its own message: it fired, so the caller has already been
  # told the wait ended, and every other reading here would be a consequence of that kill.
  if [[ "$transport" -eq 124 ]]; then
    warn "[$RT_PROFILE] exec output is TRUNCATED: $seen arrived before the bound ended the wait. What you have is a PREFIX."
    return 124
  fi

  # No trailer: the stream ended before the remote command finished, so nothing establishes that
  # what came through is the whole of it. Returning 0 here is what let a partial payload parse as
  # a complete one.
  if [[ -z "$trailer" ]]; then
    warn "[$RT_PROFILE] exec output is TRUNCATED: $seen arrived and then the stream ended without the remote command reporting that it had finished. Treat what you received as a PREFIX, not as the answer."
    if [[ "$transport" -ne 0 ]]; then
      return "$transport"
    fi
    # 125 for "no outcome was established", beside the 124 already used for the bound, and
    # following timeout(1)/env(1), which reserve it for a failure of the wrapper itself.
    return 125
  fi

  # The command finished, but the hand-off did not. A consumer that closed early takes the tail
  # with it, and the command may still have exited 0 — so this must not fall through to a status
  # that reads as success.
  if [[ "$forward" -ne 0 ]]; then
    warn "[$RT_PROFILE] exec did NOT deliver the whole payload: forwarding stopped after $seen because whatever was reading rt's stdout closed first. The remote command finished; what reached you is a PREFIX. Redirect to a file rather than piping."
    if [[ "$trailer" -ne 0 ]]; then
      return "$trailer"
    fi
    return 125
  fi

  # Everything the command wrote reached the channel, and everything on the channel was handed on.
  # Below the threshold nothing is printed at all: a small output must behave exactly as it did
  # before. Above it, the size is the caller's only handle on a cut further downstream than rt
  # can see at all.
  if [[ -n "$bytes" ]] && [[ "$bytes" -ge "$report" ]]; then
    info "[$RT_PROFILE] exec delivered $bytes bytes of stdout, complete. If what you captured holds fewer, it was cut AFTER rt — write it to a file instead of capturing the stream."
  fi
  return "$trailer"
}

_exec_sync() {
  local command="$1"
  local limit="${2:-}"

  # Everything that can `die` happens BEFORE the readers start. A `die` between mkfifo and the
  # ssh call would leave them blocked forever on a fifo open that no writer ever reaches.
  local token remote
  token="__rt_exec_end_${$}_${RANDOM}__"
  remote="$(_exec_remote_cmd "$token" "$command")"

  local acct
  acct="$(mktemp -d "${TMPDIR:-/tmp}/rt-exec.XXXXXX")" \
    || die "Could not create a temporary directory for exec accounting (TMPDIR=${TMPDIR:-/tmp})."
  mkfifo "$acct/out" "$acct/dup" "$acct/err" \
    || { rm -rf "$acct"; die "Could not create the pipes 'exec' uses to account for its own output."; }

  # Readers first, and in this order: opening a fifo blocks until the other end opens, so `wc`
  # must be waiting before `tee` opens its copy, and `tee` before ssh's redirection opens the
  # payload end.
  wc -c < "$acct/dup" > "$acct/bytes" &
  local wc_pid=$!
  tee "$acct/dup" < "$acct/out" &                    # the payload's only path to rt's stdout
  local tee_pid=$!
  _exec_trailer_filter "$token" "$acct/rc" < "$acct/err" >&2 &
  local filter_pid=$!

  local transport=0
  if [[ -n "$limit" ]]; then
    _ssh_bounded "$limit" "$remote" > "$acct/out" 2> "$acct/err" || transport=$?
  else
    _ssh "$remote" > "$acct/out" 2> "$acct/err" || transport=$?
  fi

  # The redirections above close with the call, so the readers now see EOF. Wait for them rather
  # than reading their output files: a count read before `wc` has written it is a smaller number
  # reported with the same confidence, which is the shape of the defect this closes.
  #
  # The grace applies only after the bound fired, because that is the only path on which rt has
  # already promised to stop waiting and the only one that killed ssh. When ssh exits on its own
  # the channel is closed and nothing further is coming, so waiting there is waiting for a drain.
  if [[ "$transport" -eq 124 ]]; then
    # `|| true` because a reap that had to kill returns non-zero, and under `set -e` that would
    # abort the accounting it exists to make possible. The absent count says the same thing.
    _exec_reap 2 "$tee_pid" "$wc_pid" "$filter_pid" || true
  fi
  # `tee`'s status is the PASS-THROUGH's, and it is a fact in its own right: a consumer that
  # closed early kills it, and the payload then stops at whatever it had already handed on.
  local forward=0
  wait "$tee_pid"    2>/dev/null || forward=$?
  wait "$wc_pid"     2>/dev/null || true
  wait "$filter_pid" 2>/dev/null || true

  local bytes trailer
  bytes="$(cat "$acct/bytes" 2>/dev/null || true)";  bytes="${bytes//[!0-9]/}"
  trailer="$(cat "$acct/rc" 2>/dev/null || true)";   trailer="${trailer//[!0-9]/}"
  rm -rf "$acct"

  _exec_account "$bytes" "$trailer" "$transport" "$forward"
}

# Bound an `_ssh` call in the WRAPPER, in pure Bash.
#
# The recorded failure is that callers bound a remote read by writing `timeout 30 rt … exec …`
# on the Mac, and **macOS has no `timeout`** — it is `gtimeout`, from coreutils, and usually not
# installed. The command then dies with "command not found: timeout" without ever running. A
# sibling report in another project records the nastier version of the same thing: written as
# `timeout 120 <cmd> | head -3`, the PIPELINE still exits 0 because `head` succeeded, so the
# read looks like a success that returned nothing.
#
# So the bound belongs here rather than in the caller's shell or the remote's: no GNU binary,
# no PATH assumption, and one exit code that means this and nothing else.
#
# 124 is timeout(1)'s conventional code, so a caller that already branched on `timeout`'s status
# does not have to learn a new one. Granularity is 1s, as in `_run_bounded`.
_ssh_bounded() {
  local limit="$1"; shift
  # `ssh` is invoked DIRECTLY rather than through `_ssh`. Backgrounding a shell FUNCTION forks a
  # subshell, so `$!` would be the subshell's pid and `kill` would leave the real ssh running —
  # measured: the bound returned at 3s while the remote command's output still arrived at 30s,
  # because the surviving ssh held the pipe open. The point of the bound is that the caller stops
  # waiting, so the process that must die is ssh itself.
  # No redirection: the remote command's stdout/stderr are the point of `exec`.
  ssh "${SSH_OPTS[@]}" "$REMOTE_HOST" "$@" &
  local pid=$! waited=0
  while kill -0 "$pid" 2>/dev/null; do
    if (( waited >= limit )); then
      kill "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      # Say what was NOT established. Killing the local ssh client does not reliably kill the
      # remote process — there is no tty to carry a SIGHUP — so the remote command may still be
      # running, and any output it produces after this point is lost rather than absent.
      warn "[$RT_PROFILE] Remote command exceeded ${limit}s and the local ssh was killed. The REMOTE process may still be running; this bound is on the wait, not on the work."
      return 124
    fi
    sleep 1
    waited=$((waited + 1))
  done
  wait "$pid"
}

_exec_bg() {
  local command="$1"
  local name="$2"

  # Check remote tmux
  if ! _ssh "command -v tmux" >/dev/null 2>&1; then
    die "tmux not found on remote server. Install tmux on $REMOTE_HOST for background execution."
  fi

  # Generate session name.
  #
  # `--name` is agent-supplied and lands in the payload below, where it sits inside a tmux
  # argument inside an ssh argument, next to two further layers of quoting. Quoting it correctly
  # through all three is far more fragile than refusing the characters, so this site is
  # protected by a GRAMMAR: after this check the name cannot contain a quote, a space, or any
  # shell metacharacter, which is also what makes `${log_file}` safe unquoted below.
  local session
  if [[ -n "$name" ]]; then
    _require_jobname "$name"
    session="${RT_SESSION_PREFIX}${name}"
  else
    session="${RT_SESSION_PREFIX}$(date +%s)_$$"
  fi

  # Create remote log directory
  _ssh "mkdir -p ~/.rt_logs"

  # Start tmux session on remote.
  #
  # The status is captured from the COMMAND, in its own marker file, not from `$?` after the
  # pipeline. `{ cmd; } | tee log; echo "EXIT_CODE=$?"` records TEE's status — and tee
  # essentially always succeeds — so every background job, including one that died on its first
  # line, was recorded as EXIT_CODE=0 and listed by `rt logs` as [DONE]. A caller reading that
  # list to decide whether a training run finished was told yes for every run that ever started.
  # Reproduced 2026-08-02: `{ false; } | tee f; echo $?` -> 0.
  #
  # `${PIPESTATUS[0]}` would be the short fix and is bash-only; tmux starts the remote login
  # shell, so on a dash/ash host it would expand to nothing and fail silently — which is the
  # class of defect being fixed. The marker file is POSIX, and it keeps `tee`, so the tmux pane
  # still shows live output. The `cd` is inside the group as well: a failed `cd` used to
  # short-circuit before `tee`, leaving no log at all rather than a recorded failure.
  #
  # The command runs in a SUBSHELL `( … )`, not a group `{ …; }`. A pipeline's group is already
  # a subshell, so a command that is literally `exit N` terminates it before the marker is
  # written and the status is lost — measured: `exit 7` recorded nothing, while `false`,
  # `sh -c 'exit 7'` and a failing binary all recorded correctly. The explicit subshell contains
  # the `exit` and records all four.
  #
  # CORRECTION to this commit's own first claim, from an adversarial pass: the OLD construct did
  # NOT leave "no log at all" after a failed `cd`. `cd X && { … } | tee log` short-circuits before
  # tee, but the trailing `echo "EXIT_CODE=$?" >> log` still runs and CREATES the file with the
  # cd's status. So a failed cd was the ONE case the old form recorded correctly. Moving `cd`
  # inside the group is still right — it keeps one path for every failure instead of two — but it
  # fixes a uniformity problem, not a lost-log one.
  local log_file="~/.rt_logs/${session}.log"
  _ssh \
    "tmux new-session -d -s '${session}' -x 200 -y 50 \
      \"{ cd '${REMOTE_DIR}' && ( ${command} ); echo \\\$? > ${log_file}.rc; } 2>&1 | tee ${log_file}; \
        echo \\\"EXIT_CODE=\\\$(cat ${log_file}.rc 2>/dev/null || echo unknown)\\\" >> ${log_file}\""

  info "[$RT_PROFILE] Background job started: $session"
  info "  Check output: rt -p $RT_PROFILE logs $session"
}

cmd_logs() {
  load_config

  _ssh_test || die "[$RT_PROFILE] Cannot reach $REMOTE_HOST. Run 'rt connect' first."

  local job_id="${1:-}"
  local follow=false
  [[ "${2:-}" == "--follow" || "${2:-}" == "-f" ]] && follow=true

  # The id names a tmux session / log file and reaches a remote `tail`/`cat`. Both call sites
  # quote it, but validating here means an obviously-wrong id fails locally with a clear message
  # instead of as a remote "no such file".
  [[ -n "$job_id" ]] && _require_jobname "$job_id"

  if [[ -z "$job_id" ]]; then
    _logs_list
  elif [[ "$follow" == true ]]; then
    _ssh "tail -f ~/.rt_logs/$(_shq "${job_id}.log")" 2>/dev/null \
      || die "Log not found: $job_id"
  else
    _logs_show "$job_id"
  fi
}

_logs_list() {
  info "[$RT_PROFILE] Background jobs on $REMOTE_HOST:"
  printf '\n'

  # Get running tmux sessions
  local running
  running=$(_ssh \
    "tmux list-sessions -F '#{session_name}' 2>/dev/null | grep '^${RT_SESSION_PREFIX}'" 2>&1) || {
    if [[ "$running" == *"Connection"* || "$running" == *"resolve"* || "$running" == *"No route"* ]]; then
      warn "Cannot reach $REMOTE_HOST"
      return 1
    fi
    running=""
  }

  # Get all log files
  local logs
  logs=$(_ssh \
    "ls -1 ~/.rt_logs/${RT_SESSION_PREFIX}*.log 2>/dev/null | xargs -I{} basename {} .log" 2>/dev/null) || true

  if [[ -z "$running" && -z "$logs" ]]; then
    printf '  (none)\n'
    return 0
  fi

  # Print running sessions
  while IFS= read -r s; do
    [[ -n "$s" ]] && printf '  %-40s  [RUNNING]\n' "$s"
  done <<< "$running"

  # Print finished (has log but no tmux session)
  while IFS= read -r s; do
    [[ -n "$s" ]] || continue
    if ! echo "$running" | grep -qx "$s"; then
      local exit_code
      exit_code=$(_ssh \
        "tail -1 ~/.rt_logs/$(_shq "${s}.log") 2>/dev/null | sed -n 's/.*EXIT_CODE=\([0-9][0-9]*\).*/\1/p'" 2>/dev/null) || exit_code=""
      # No marker at all is NOT a completed job. The session is gone and nothing recorded a
      # status, which is what a killed job, a `rt disconnect`, or a host reboot looks like — and
      # it used to render as `[EXITED: ]`, an empty field a reader parses as "finished, no
      # detail". Say which of the three states this is.
      if [[ "$exit_code" == "0" ]]; then
        printf '  %-40s  [DONE]\n' "$s"
      elif [[ -z "$exit_code" ]]; then
        printf '  %-40s  [NO STATUS — session gone, nothing recorded an exit code]\n' "$s"
      else
        printf '  %-40s  [EXITED: %s]\n' "$s" "$exit_code"
      fi
    fi
  done <<< "$logs"
}

_logs_show() {
  local job_id="$1"
  _ssh "cat ~/.rt_logs/$(_shq "${job_id}.log")" 2>/dev/null \
    || die "Log not found: $job_id"
}

cmd_status() {
  # If --all flag, show all profiles
  if [[ "${1:-}" == "--all" || "${1:-}" == "-a" ]]; then
    _status_all
    return
  fi

  load_config

  printf '\n'
  local sync_state
  sync_state=$(_sync_status)

  if [[ "$sync_state" != "none" ]]; then
    local host="${REMOTE_HOST}"
    local rdir="${REMOTE_DIR}"
    local local_dir="${LOCAL_DIR}"

    [[ -f "$RT_STATE_DIR/host" ]]       && host=$(cat "$RT_STATE_DIR/host")
    [[ -f "$RT_STATE_DIR/remote_dir" ]] && rdir=$(cat "$RT_STATE_DIR/remote_dir")
    [[ -f "$RT_STATE_DIR/local_dir" ]]  && local_dir=$(cat "$RT_STATE_DIR/local_dir")

    local ssh_ok="reachable"
    _ssh_test || ssh_ok="UNREACHABLE"

    local bg_running=0
    if [[ "$ssh_ok" == "reachable" ]]; then
      bg_running=$(_ssh \
        "tmux list-sessions -F '#{session_name}' 2>/dev/null | grep -c '^${RT_SESSION_PREFIX}'" 2>/dev/null) || bg_running=0
    fi

    printf '  Profile:     %s\n' "$RT_PROFILE"
    printf '  Sync:        %s\n' "$sync_state"
    # A session that is not synchronising should say why here; the state word alone does not
    # tell you whether recreating it would help or would decide something for you.
    case "$sync_state" in
      erroring) printf '  Sync error:  %s\n' "$(_sync_last_error)" ;;
      halted)   printf '  Sync error:  Mutagen safety brake (root emptied/deleted/type-changed) — see '"'"'rt -p %s sync status'"'"'\n' "$RT_PROFILE" ;;
    esac
    printf '  SSH:         %s\n' "$ssh_ok"
    # Sync-set size, with its SCOPE: an unscanned endpoint reports zeros, and printing those as
    # "0 files" would be a measurement the session has not made.
    local _counts
    if _counts=$(_sync_counts); then
      printf '  Sync set:    %s files, %s MB\n' "${_counts%% *}" "$(( ${_counts##* } / 1048576 ))"
    else
      printf '  Sync set:    (not established — endpoint not scanned yet)\n'
    fi
    printf '  Remote host: %s\n' "$host"
    printf '  Remote dir:  %s\n' "$rdir"
    printf '  Local dir:   %s\n' "$local_dir"
    [[ "${SLURM_ENABLED:-0}" == "1" ]] && printf '  Slurm:       enabled\n'
    if [[ $bg_running -gt 0 ]]; then printf '  Background:  %d running\n' "$bg_running"; fi
  else
    printf '  Profile:     %s\n' "$RT_PROFILE"
    printf '  Sync:        none\n'
  fi
  printf '\n'
}

# Read a profile's identity WITHOUT polluting this shell. Config files are sourced bash, so
# reading eleven of them in a loop would leak each one's variables into the next — a profile
# that does not set REMOTE_DIR would silently inherit the previous profile's. The subshell is
# the whole mechanism.
_profile_identity() {   # <host> <profile> -> "host<TAB>remote_dir<TAB>local_dir"
  local h="$1" p="$2"
  (
    set +u
    REMOTE_HOST=""; REMOTE_DIR=""; LOCAL_DIR=""
    [[ -f "${RT_HOME}/${h}/host.conf" ]] && . "${RT_HOME}/${h}/host.conf"
    [[ -f "${RT_HOME}/${h}/${p}.conf" ]] && . "${RT_HOME}/${h}/${p}.conf"
    printf '%s\t%s\t%s' "$REMOTE_HOST" "$REMOTE_DIR" "${LOCAL_DIR:-$HOME/Work/Remote/${h}/${p}}"
  ) 2>/dev/null
}

# `status --all` enumerated STATE DIRECTORIES — the record `connect` writes — not configured
# profiles. So a profile that was configured and never connected did not exist as far as this
# command was concerned, which is exactly the question you run it to answer. The SKILL's first
# instruction is to run this to enumerate profiles before assuming which one to use, so the one
# documented use was the one it did not serve. Measured 2026-08-05 on this machine: 11 profile
# configs, 10 state dirs, one configured profile invisible. (The 2026-08-02 record said "4
# shown"; that magnitude does NOT reproduce today — the defect does.)
#
# Now: enumerate CONFIGS, and union in any state dir that has no config, because a profile whose
# `.conf` was deleted while it was connected is still syncing and leaving it out would reproduce
# this very defect one directory over.
_status_all() {
  local -a keys=()
  local hdir hname f pdir pname

  if [[ -d "$RT_HOME" ]]; then
    for hdir in "$RT_HOME"/*/; do
      [[ -d "$hdir" ]] || continue
      hname=$(basename "$hdir")
      # A directory whose name is not a valid host-group segment is not a host group — e.g. an
      # `_archive/` of retired configs. Skipped by the same rule that validates `-p`, rather
      # than by a hardcoded name list.
      [[ "$hname" =~ ^[a-zA-Z0-9](-?[a-zA-Z0-9])*$ ]] || continue
      for f in "$hdir"*.conf; do
        [[ -f "$f" ]] || continue
        pname=$(basename "$f" .conf)
        [[ "$pname" == "host" ]] && continue
        keys+=("${hname}/${pname}")
      done
    done
  fi

  local state_base="${RT_HOME}/.rt"
  if [[ -d "$state_base" ]]; then
    for hdir in "$state_base"/*/; do
      [[ -d "$hdir" ]] || continue
      hname=$(basename "$hdir")
      for pdir in "$hdir"*/; do
        [[ -d "$pdir" ]] || continue
        pname=$(basename "$pdir")
        keys+=("${hname}/${pname}")
      done
    done
  fi

  printf '\n'
  if [[ ${#keys[@]} -eq 0 ]]; then
    printf '  No profiles configured. Create one with: rt -p <host>/<profile> init\n\n'
    return
  fi

  local key h p sync_state host rdir local_dir tag configured live=0 total=0
  while IFS= read -r key; do
    [[ -n "$key" ]] || continue
    h="${key%%/*}"; p="${key#*/}"
    total=$((total + 1))

    sync_state=$(_sync_status "$h" "$p")
    [[ "$sync_state" != "none" && "$sync_state" != "unknown" ]] && live=$((live + 1))

    # The live session's own record wins where it exists — it is what the session was actually
    # created with, and the config may have been edited since. Otherwise fall back to the
    # config, which is the only source for a profile that has never connected.
    host=""; rdir=""; local_dir=""
    pdir="${state_base}/${h}/${p}"
    if [[ -f "$pdir/host" ]]; then
      host=$(cat "$pdir/host" 2>/dev/null)
      [[ -f "$pdir/remote_dir" ]] && rdir=$(cat "$pdir/remote_dir" 2>/dev/null)
      [[ -f "$pdir/local_dir" ]]  && local_dir=$(cat "$pdir/local_dir" 2>/dev/null)
    else
      IFS=$'\t' read -r host rdir local_dir <<< "$(_profile_identity "$h" "$p")"
    fi

    configured=no
    [[ -f "${RT_HOME}/${h}/${p}.conf" ]] && configured=yes
    tag=""
    [[ "$configured" == "no" ]] && tag="  ⚠ no config file — 'rt -p ${h}/${p} <cmd>' will fail"

    printf '  [%s/%s] sync=%s — %s:%s ⇄ %s%s\n' "$h" "$p" "$sync_state" "$host" "$rdir" "$local_dir" "$tag"
  done < <(printf '%s\n' "${keys[@]}" | sort -u)

  # Name the scope. A bare list of rows does not say whether "not listed" means "does not
  # exist" or "this command does not look there" — which is the defect being closed.
  printf '\n  %d profile(s) known to %s; %d with a live sync session.\n\n' "$total" "$RT_HOME" "$live"
}

# ── Sync subcommand (Mutagen passthroughs) ────────────────────────
cmd_sync() {
  load_config
  _mutagen_check

  local sub="${1:-}"
  shift || true

  case "$sub" in
    flush)
      if ! _has_sync; then
        die "[$RT_PROFILE] No active sync session. Run 'rt connect' first."
      fi
      # This command's ONLY job is to flush, so its exit code must say whether it did. It
      # previously returned the warn's status, i.e. 0, so a caller could not tell.
      local _frc=0
      _sync_flush || _frc=$?
      case "$_frc" in
        0) info "[$RT_PROFILE] Sync flushed." ;;
        3) warn "[$RT_PROFILE] Flush did not finish within ${RT_FLUSH_TIMEOUT:-10}s; the daemon is still syncing. Re-run, or raise RT_FLUSH_TIMEOUT."; return 3 ;;
        *) warn "[$RT_PROFILE] Could NOT flush (paused session or a mutagen error) — nothing was synchronised. Check 'rt sync status'."; return 2 ;;
      esac
      ;;
    status)
      info "[$RT_PROFILE] Sync state: $(_sync_status)"
      _sync_report_ignores
      mutagen sync list --label-selector "$(_sync_label_selector)" 2>&1 || true
      ;;
    "")
      die "Usage: rt sync <flush|status>"
      ;;
    *)
      die "Unknown sync subcommand: $sub"
      ;;
  esac
}

# Print the ignore set the LIVE session is enforcing, and say plainly when the profile's
# current text no longer matches it.
#
# The documented sync scope was materially wider than the implementation: the docs said files
# sync to and from the remote and never enumerated the exclusions, so a result written to
# `outputs/`, `checkpoints/` or `wandb/` never reached the local replica and nothing said why.
# Worse, ignores are applied only at session-CREATE time, so the natural fix — edit
# MUTAGEN_IGNORE — changes nothing about the running session, and the config file everyone
# reads to answer "what is excluded?" is then simply wrong about it.
_sync_report_ignores() {
  local live want
  live=$(_sync_live_ignores) || live=""
  if ! _has_sync; then
    printf '  Effective ignores: (no live session — these would apply on the next connect)\n'
    _ignore_patterns | sed 's/^/    /'
    return
  fi

  printf '  Effective ignores (LIVE session; frozen at create time):\n'
  if [[ -z "$live" ]]; then
    printf '    (none)\n'
  else
    printf '%s\n' "$live" | sed '/^$/d; s/^/    /'
  fi
  # Match the enum EXACTLY. `*Ignore*` matched all three values, because every one of them
  # contains the literal "IgnoreVCSMode" — so this line said ".git/ is ignored" even for
  # `Propagate`, which is the value that means it is SYNCED. A query that fails says so rather
  # than picking a side.
  case "$(_sync_live_vcs)" in
    IgnoreVCSModeIgnore)                        printf '    [VCS directories such as .git/ are ignored]\n' ;;
    IgnoreVCSModePropagate|IgnoreVCSModeDefault) printf '    [VCS directories such as .git/ are SYNCED]\n' ;;
    *)                                          printf '    [VCS directory handling: could not be established]\n' ;;
  esac

  want=$(_ignore_patterns)
  if [[ "$(printf '%s\n' "$live" | sed '/^$/d' | sort)" != "$(printf '%s\n' "$want" | sed '/^$/d' | sort)" ]]; then
    warn "[$RT_PROFILE] The live session's ignores DIFFER from what this profile's config would create now. Ignores are frozen at session-create time, so editing MUTAGEN_IGNORE has not changed what is being excluded. Recreate to apply: 'rt -p $RT_PROFILE disconnect && rt -p $RT_PROFILE connect'."
    printf '  Config would create (differences marked):\n'
    # `|| true`: `diff` exits 1 when the inputs differ, which is ALWAYS the case here, and under
    # `set -euo pipefail` that aborted the whole command. Measured: `rt sync status` on a
    # drifted profile printed the differences, then exited 1 without the Mutagen dump that
    # follows — the diagnostic command failing on exactly the profiles it exists to diagnose.
    diff <(printf '%s\n' "$live" | sed '/^$/d' | sort) <(printf '%s\n' "$want" | sed '/^$/d' | sort) \
      | sed -n 's/^</    only LIVE:   /p; s/^>/    only CONFIG: /p' || true
  fi
}

# ── verify: the arrival assertion ──────────────────────────────────────────────
#
# Nothing told a caller when a staged file had actually ARRIVED, so callers slept a fixed
# interval and then used whatever was there. Measured 2026-08-01: a patched launcher was staged,
# waited on for ten seconds, and the still-stale remote copy was copied into place. `bash -n`
# passed because the OLD file is valid shell, so the run started, died instantly on an unknown
# case, and held 8 GPUs idle for ~25 minutes.
#
# A returned flush is NOT the missing signal. Flush forces a synchronization CYCLE; it does not
# prove the endpoints are equal, and both an unresolved conflict and an ignored path flush with
# exit 0 while the two sides differ. The only thing that establishes arrival is CONTENT: hash
# the launch set here, make the remote hash the same paths, and compare.
#
# Scope, per the human ruling of 2026-08-05: this is the arrival assertion only. The per-run
# staging wrapper the design note proposes is a separate, larger decision and is not this.

# Digest one file, reading from stdin so the filename never reaches the tool's output and the
# two platforms' differing output formats do not have to be reconciled. Linux has sha256sum;
# macOS has only shasum. Missing BOTH is "unverifiable", never "mismatch".
_sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum < "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 < "$1" | awk '{print $1}'
  else
    return 97
  fi
}

# "<digest>  <relative-path>" per path, in the caller's order. The PATH is bound into the record
# so that renaming or swapping two files cannot produce an equal manifest.
_local_digests() {
  local p h
  for p in "$@"; do
    h=$(_sha256_file "${LOCAL_DIR}/${p}") || return 97
    printf '%s  %s\n' "$h" "$p"
  done
}

# The same thing, as one remote shell program. A path that is absent remotely yields MISSING
# rather than nothing: an empty line would compare equal to another empty line, and "absent on
# both sides" is not the question being asked.
_remote_digest_cmd() {
  local p out
  out='if command -v sha256sum >/dev/null 2>&1; then RTH=sha256sum; '
  out+='elif command -v shasum >/dev/null 2>&1; then RTH="shasum -a 256"; '
  out+='else echo RT_NO_SHA_TOOL; exit 97; fi; '
  out+="cd $(_shq "$REMOTE_DIR") || { echo RT_NO_REMOTE_DIR; exit 98; }; "
  for p in "$@"; do
    out+="if [ -f $(_shq "$p") ]; then "
    out+="printf '%s  %s\\n' \"\$(\$RTH < $(_shq "$p") | awk '{print \$1}')\" $(_shq "$p"); "
    out+="else printf 'MISSING  %s\\n' $(_shq "$p"); fi; "
  done
  printf '%s' "$out"
}

# Is this path excluded by the LIVE session's ignore rules? A match here is authoritative: the
# file can never arrive, so waiting for it is waiting forever.
#
# This deliberately implements only the pattern SHAPES `rt` itself generates — `dir/`, `*.ext`,
# and a bare name — not Mutagen's full ignore grammar. So a MATCH is a fact and a NON-MATCH
# claims nothing: an unexplained mismatch is reported as "not equal by the deadline", never as
# "still converging". Reimplementing the whole matcher in Bash would produce a checker that is
# confidently wrong, which is worse than one with a stated bound.
_ignored_reason() {
  local path="$1" pat base rules
  rules=$(_sync_live_ignores) || return 1

  # A negation re-includes a path an earlier rule excluded, and resolving that needs Mutagen's
  # real ordering semantics. Checked BEFORE any matching, because the excluding rule usually
  # comes first and would otherwise answer before the negation is ever seen. `rt` never
  # generates one, so this only fires on a hand-written MUTAGEN_IGNORE — where declining to
  # claim is better than refusing a path that would in fact sync.
  case "$rules" in \!*|*$'\n'\!*) return 1 ;; esac

  while IFS= read -r pat; do
    [[ -n "$pat" ]] || continue
    if [[ "$pat" == */ ]]; then
      base="${pat%/}"
      # NOT `"/$path/"`. Wrapping the path in a trailing slash made `outputs/` match a regular
      # FILE named `outputs`, and Mutagen's trailing slash means directory-only. Comparing
      # `/outputs` against `*/outputs/*` correctly matches `outputs/x` and not `outputs`.
      case "/$path" in */"$base"/*) printf '%s' "$pat"; return 0 ;; esac
    elif [[ "$pat" == \** ]]; then
      # shellcheck disable=SC2254
      case "${path##*/}" in $pat) printf '%s' "$pat"; return 0 ;; esac
    else
      case "/$path" in */"$pat") printf '%s' "$pat"; return 0 ;; esac
    fi
  done <<< "$rules"
  return 1
}

# Does any component of this relative path traverse a symlink out of LOCAL_DIR? Checking only
# the final component (`[[ -L $LOCAL_DIR/$p ]]`) misses `sub/file` where `sub` itself is a
# symlink pointing outside the profile root — verify would then certify a file neither endpoint
# is syncing.
_escapes_via_symlink() {
  local rel="$1" acc="$LOCAL_DIR" part
  local IFS=/
  for part in $rel; do
    [[ -n "$part" ]] || continue
    acc="${acc}/${part}"
    [[ -L "$acc" ]] && { printf '%s' "$acc"; return 0; }
  done
  return 1
}

# EXIT CODES, deliberately the same three-way split the flush codes use:
#   0  equality OBSERVED, and observed to be stable across the check.
#   2  BLOCKED or unverifiable — a bad path, an ignored path, no sync session, no hashing tool
#      on the remote. Waiting longer cannot help.
#   3  the deadline elapsed while the two sides still differed. This says non-arrival; it does
#      NOT claim the daemon is still making progress, because a mismatch is not evidence of that.
cmd_verify() {
  load_config

  local timeout_s=60 interval=2
  local paths=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --timeout)   timeout_s="$2"; shift 2 ;;
      --timeout=*) timeout_s="${1#--timeout=}"; shift ;;
      --interval)  interval="$2"; shift 2 ;;
      --interval=*) interval="${1#--interval=}"; shift ;;
      --)          shift; paths+=("$@"); break ;;
      -*)          die2 "Unknown flag: $1" ;;
      *)           paths+=("$@"); break ;;
    esac
  done

  [[ ${#paths[@]} -gt 0 ]] \
    || die2 "Usage: rt verify [--timeout SECS] [--interval SECS] <path>... (paths are relative to the profile root)"
  [[ "$timeout_s" =~ ^[0-9]+$ ]]  || die2 "--timeout takes whole seconds, got '$timeout_s'."
  [[ "$interval" =~ ^[1-9][0-9]*$ ]] || die2 "--interval takes whole seconds greater than zero, got '$interval'."

  # Every reason a path can never be verified is decided HERE, before any waiting. A caller that
  # waits 60 seconds to be told its path was misspelled has been told the wrong thing slowly.
  #
  # Order matters: purely LOCAL facts first (they need nothing and are the most common mistake),
  # then the session state, then the ignore check — which reads the LIVE session and would be
  # silently useless if the daemon could not be asked. Checking the session first means that
  # case is reported as "could not establish", not as "not ignored".
  local p reason
  for p in "${paths[@]}"; do
    [[ -n "$p" ]]         || die2 "Empty path"
    [[ "$p" != /* ]]      || die2 "verify takes paths RELATIVE to the profile root, got absolute '$p'. (Local root: $LOCAL_DIR)"
    case "/$p/" in */../*) die2 "Path escapes the profile root: '$p'" ;; esac
    # A newline would split one path across two manifest lines on BOTH sides, making the
    # comparison and the per-file mismatch report describe something other than the file.
    [[ "$p" != *$'\n'* ]] || die2 "Path contains a newline, which the digest manifest is line-oriented about: $(printf '%q' "$p")"
    if reason=$(_escapes_via_symlink "$p"); then
      die2 "'$p' passes through a symlink ($reason). Hashing the link text would not prove what the remote launches, following it would not prove the link, and an intermediate one can leave the profile root entirely. Verify the real path."
    fi
    [[ ! -d "${LOCAL_DIR}/${p}" ]] \
      || die2 "'$p' is a directory. Verify the files you are about to launch, by name — a recursive manifest brings in ordering, ignored descendants and mid-check mutation, which is a larger decision than this."
    [[ -f "${LOCAL_DIR}/${p}" ]] \
      || die2 "'$p' does not exist locally (looked in $LOCAL_DIR). Local is the authority for what you are staging; there is nothing to assert about."
  done

  local st
  st=$(_sync_status)
  case "$st" in
    none)    die2 "[$RT_PROFILE] No sync session, so nothing is propagating these files. 'rt -p $RT_PROFILE connect' first." ;;
    unknown) die2 "[$RT_PROFILE] Could not establish the sync session's state, so this cannot report on arrival either." ;;
    paused|halted|erroring)
      die2 "[$RT_PROFILE] Sync is '$st' and is propagating nothing, so these files will not arrive. 'rt -p $RT_PROFILE sync status' says why." ;;
  esac

  for p in "${paths[@]}"; do
    if reason=$(_ignored_reason "$p"); then
      warn "[$RT_PROFILE] '$p' matches the live session's ignore rule '${reason}'."
      die2 "That path is excluded from sync, so it can NEVER arrive by syncing and waiting for it would wait forever. Stage it another way, or remove the rule and recreate the session."
    fi
  done

  local remote_cmd deadline now
  remote_cmd=$(_remote_digest_cmd "${paths[@]}")
  now=$(date +%s); deadline=$(( now + timeout_s ))

  local local1 local2 remote rrc
  while :; do
    # L1, R, then L2. Accepting only L1 == R == L2 means a file edited DURING the check cannot
    # be certified: the local side moved, so the remote digest describes neither state. The
    # contract is "equality was observed and held across the check", not "these bytes are now
    # frozen" — nothing here can promise the second.
    local1=$(_local_digests "${paths[@]}") \
      || die2 "[$RT_PROFILE] No sha256 tool locally (need sha256sum or shasum). Cannot verify — this is unverifiable, not a mismatch."

    rrc=0
    remote=$(_ssh "$remote_cmd" 2>/dev/null) || rrc=$?
    if grep -q '^RT_NO_SHA_TOOL' <<< "$remote"; then
      die2 "[$RT_PROFILE] The remote has neither sha256sum nor shasum, so arrival cannot be established there. Unverifiable, NOT a mismatch."
    fi
    if grep -q '^RT_NO_REMOTE_DIR' <<< "$remote"; then
      die2 "[$RT_PROFILE] Remote directory does not exist: $REMOTE_DIR"
    fi
    # ANY non-zero status from the evidence-producing command makes its output inadmissible —
    # not just an empty one. A forced-command wrapper, a dying transport, or a remote shell that
    # fails after printing can emit a complete, MATCHING manifest and still exit non-zero, and
    # certifying arrival on that is a benign result over a scope that was never established.
    if (( rrc != 0 )); then
      die2 "[$RT_PROFILE] The remote digest command exited $rrc, so its output cannot be used as evidence. Unverifiable, NOT a mismatch and NOT an arrival."
    fi

    local2=$(_local_digests "${paths[@]}") || die2 "[$RT_PROFILE] No sha256 tool locally."

    if [[ "$local1" == "$local2" && "$local1" == "$remote" ]]; then
      info "[$RT_PROFILE] ARRIVED: ${#paths[@]} path(s) are byte-identical on both sides."
      return 0
    fi

    now=$(date +%s)
    if (( now >= deadline )); then
      if [[ "$local1" != "$local2" ]]; then
        warn "[$RT_PROFILE] The local files kept changing during every attempt, so no stable state was ever compared."
        return 3
      fi
      warn "[$RT_PROFILE] NOT ARRIVED after ${timeout_s}s. These differ:"
      # Report per path, so the caller learns WHICH file and whether it is absent or different.
      local line want got
      while IFS= read -r line; do
        want="${line%%  *}"; p="${line#*  }"
        # `|| true`: grep exits 1 when the remote said nothing about this path, and under
        # `set -euo pipefail` that would abort here and exit 1 — leaking a status outside the
        # 0/2/3 contract this command promises, in the middle of reporting a mismatch.
        got=$(grep -F "  $p" <<< "$remote" | head -1) || true
        got="${got%%  *}"
        [[ "$want" == "$got" ]] && continue
        if [[ "$got" == "MISSING" ]]; then
          printf '    %-40s absent on the remote\n' "$p" >&2
        else
          printf '    %-40s differs (local %s… remote %s…)\n' "$p" "${want:0:8}" "${got:0:8}" >&2
        fi
      done <<< "$local1"
      warn "[$RT_PROFILE] A mismatch is NOT evidence that sync is still working on it — check 'rt -p $RT_PROFILE sync status'."
      return 3
    fi
    # Sleep no longer than the deadline allows. Sleeping a full interval AFTER checking the
    # deadline made `--timeout 1 --interval 3` take 3 seconds, i.e. --timeout was not the bound
    # it claims to be; a large interval could overshoot by that much.
    local _left=$(( deadline - now ))
    (( _left > interval )) && _left=$interval
    (( _left > 0 )) && sleep "$_left"
  done
}

# ── Slurm subcommand (opt-in via SLURM_ENABLED=1) ─────────────────
cmd_slurm() {
  load_config
  _slurm_require_enabled

  local sub="${1:-}"
  shift || true

  case "$sub" in
    submit) _slurm_submit "$@" ;;
    queue)  _slurm_queue  "$@" ;;
    cancel) _slurm_cancel "$@" ;;
    logs)   _slurm_logs   "$@" ;;
    "")     die "Usage: rt slurm <submit|queue|cancel|logs> ..." ;;
    *)      die "Unknown slurm subcommand: $sub" ;;
  esac
}

_slurm_require_enabled() {
  [[ "${SLURM_ENABLED:-0}" == "1" ]] \
    || die "Slurm is not enabled for profile '${RT_PROFILE}'. Set SLURM_ENABLED=1 in $RT_CONF."
}

_slurm_submit() {
  local script=""
  local assume_staged=false
  local sbatch_args=()
  # Per-profile default sbatch args (SLURM_SBATCH_ARGS in host.conf/profile.conf)
  # seed the list FIRST, so explicit '-- ...' args land after them and win
  # (sbatch: last occurrence of a flag takes effect).
  if [[ -n "${SLURM_SBATCH_ARGS:-}" ]]; then
    read -r -a sbatch_args <<< "$SLURM_SBATCH_ARGS"
  fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --) shift; sbatch_args+=("$@"); break ;;
      --assume-staged) assume_staged=true; shift ;;
      -*) die "Use '-- ...' to pass flags to sbatch. Got: $1" ;;
      *)  if [[ -z "$script" ]]; then script="$1"; else sbatch_args+=("$1"); fi; shift ;;
    esac
  done
  [[ -n "$script" ]] || die "Usage: rt slurm submit <script> [-- sbatch_args...]"

  _ssh_test || die "[$RT_PROFILE] Cannot reach $REMOTE_HOST."

  # Mandatory flush — script must be on remote before sbatch
  if _has_sync; then
    info "[$RT_PROFILE] Flushing sync before submit ..."
    # A submitted job outlives the shell that submitted it, so this is the one caller for which
    # even the TIMEOUT is not acceptable: there is no chance to notice and re-run.
    local _frc=0
    _sync_flush || _frc=$?
    case "$_frc" in
      2) die "Sync could NOT be flushed (paused session or a mutagen error); aborting submit to avoid queueing a job against unknown code." ;;
      3) die "Sync flush did not finish within ${RT_FLUSH_TIMEOUT:-10}s, so it is not established that the remote has your latest script; aborting rather than queueing a job that outlives this shell. Re-run once sync settles, or raise RT_FLUSH_TIMEOUT." ;;
    esac
  else
    # NO SESSION AT ALL is stronger than a failed flush, and this warned and submitted anyway —
    # more permissive for the more dangerous state. Nothing here has any idea what is on the
    # remote. --assume-staged is the deliberate escape for a script placed by other means.
    if [[ "${assume_staged:-false}" != true ]]; then
      die "[$RT_PROFILE] No active sync session, so nothing establishes that '${script}' on the remote is the script you are looking at. Run 'rt -p $RT_PROFILE connect' first, or pass --assume-staged if it was placed there by other means."
    fi
    warn "[$RT_PROFILE] No active sync session; --assume-staged given, submitting '${script}' as it stands on the remote."
  fi

  info "[$RT_PROFILE] sbatch ${sbatch_args[*]:-} ${script}"
  local output
  # Each sbatch arg is quoted as ITS OWN word. An earlier version left `${sbatch_args[*]}`
  # unquoted "because flags must word-split" — but the splitting has already happened: explicit
  # `-- …` args arrive as separate argv elements, and `SLURM_SBATCH_ARGS` was split by
  # `read -r -a` at parse time. Leaving it unquoted only ever added shell POWER, and the args
  # after `--` are agent-supplied, i.e. exactly the trust boundary this repo just closed
  # elsewhere. `rt slurm submit x -- '--comment=y;' true` built `sbatch --comment=y; true 'x'`,
  # whose status is `true`'s — so a submission that never happened reported success.
  local _qargs="" _a
  for _a in ${sbatch_args[@]+"${sbatch_args[@]}"}; do
    _qargs="${_qargs} $(_shq "$_a")"
  done
  if ! output=$(_ssh "cd $(_shq "$REMOTE_DIR") && sbatch${_qargs} $(_shq "$script")" 2>&1); then
    printf '%s\n' "$output" >&2
    die "sbatch failed."
  fi
  printf '%s\n' "$output"

  local jobid
  jobid=$(echo "$output" | sed -n 's/.*Submitted batch job \([0-9][0-9]*\).*/\1/p')
  if [[ -n "$jobid" ]]; then
    mkdir -p "$RT_STATE_DIR"
    {
      [[ -f "$RT_STATE_DIR/slurm_jobs" ]] && cat "$RT_STATE_DIR/slurm_jobs"
      printf '%s:%s:%s\n' "$jobid" "$(date +%s)" "$script"
    } | tail -50 > "$RT_STATE_DIR/slurm_jobs.tmp"
    mv "$RT_STATE_DIR/slurm_jobs.tmp" "$RT_STATE_DIR/slurm_jobs"
    info "Job $jobid recorded. Logs: rt -p $RT_PROFILE slurm logs $jobid"
  fi
}

_slurm_queue() {
  _ssh_test || die "[$RT_PROFILE] Cannot reach $REMOTE_HOST."
  local fmt='%.10i %.12P %.20j %.8T %.10M %R'
  if [[ "${1:-}" == "--all" || "${1:-}" == "-a" ]]; then
    _ssh "squeue --format='$fmt'"
  else
    _ssh "squeue -u \$USER --format='$fmt'"
  fi
}

_slurm_cancel() {
  [[ $# -gt 0 ]] || die "Usage: rt slurm cancel <jobid> [<jobid>...]"
  _ssh_test || die "[$RT_PROFILE] Cannot reach $REMOTE_HOST."
  local id qids=""
  for id in "$@"; do
    _require_jobid "$id"
    qids="${qids} $(_shq "$id")"
  done
  _ssh "scancel${qids}"
}

_slurm_logs() {
  local jobid=""
  local follow=false
  local err=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f|--follow) follow=true; shift ;;
      --err)       err=true; shift ;;
      -*)          die "Unknown flag: $1" ;;
      *)           jobid="$1"; shift ;;
    esac
  done

  if [[ -z "$jobid" ]]; then
    if [[ -f "$RT_STATE_DIR/slurm_jobs" ]]; then
      info "[$RT_PROFILE] Recent submissions (newest first):"
      printf '\n'
      awk -F: '{a[NR]=$0} END{for(i=NR;i>=1 && i>NR-10;i--) print a[i]}' "$RT_STATE_DIR/slurm_jobs" \
      | while IFS=: read -r id ts script; do
          local when="?"
          if [[ "$RT_OS" == "Darwin" ]]; then
            when=$(date -r "$ts" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "?")
          else
            when=$(date -d "@$ts" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "?")
          fi
          printf '  %-12s  %s  %s\n' "$id" "$when" "$script"
        done
      printf '\n'
    else
      info "No submissions recorded for profile '$RT_PROFILE'. Try: rt slurm queue"
    fi
    return 0
  fi

  _require_jobid "$jobid"
  _ssh_test || die "[$RT_PROFILE] Cannot reach $REMOTE_HOST."

  local ext=".out"
  $err && ext=".err"
  local primary="${SLURM_LOG_DIR}/slurm-${jobid}${ext}"
  local fallback="${REMOTE_DIR}/slurm-${jobid}${ext}"
  local path=""

  if _ssh "test -f $(_shq "$primary")"; then
    path="$primary"
  elif [[ "$primary" != "$fallback" ]] && _ssh "test -f $(_shq "$fallback")"; then
    path="$fallback"
  else
    die "Log not found: ${primary}$([[ "$primary" != "$fallback" ]] && echo " (also tried ${fallback})")"
  fi

  if $follow; then
    _ssh "tail -f $(_shq "$path")"
  else
    _ssh "cat $(_shq "$path")"
  fi
}

cmd_help() {
  cat <<HELP
Remote Toolkit — Drive remote servers from Claude Code

USAGE:
  rt -p HOST/PROFILE <command> [options]

GLOBAL FLAGS:
  -p, --profile HOST/PROFILE
                       Select a profile, in <host-group>/<profile-name> form.
                       Required (no bare-name fallback).
                       Each segment: alphanumeric + single dashes between alphanumerics
                       (no leading/trailing dash, no '--', no '_' or '.'), max 32 chars.
                       Config: \$RT_HOME/<host>/host.conf + <host>/<profile>.conf
                       Local replica: ~/Work/Remote/<host>/<profile>/

COMMANDS:
  init                 Create config directory and default config
  check                Check local dependencies, report what's missing
  setup-key            Copy SSH key to remote (one-time, password auth)
  setup-key --password PASS
                       Non-interactive key push (requires sshpass)
  connect              Start Mutagen sync; resumes a paused session; ensures daemon is running
  disconnect           Terminate sync; preserves local replica files
  exec <command>       Run a command on the remote (auto-flushes sync).
                       Exits 125 and says "output is TRUNCATED" when the stream
                       ended before the command reported finishing -- what you
                       have is a PREFIX. A complete payload of 64 KiB or more
                       reports its size (RT_EXEC_REPORT_BYTES) so you can check
                       it against what you captured; nothing caps the payload
                       here, so a cut that big happened downstream of rt.
  exec --no-flush <cmd>
                       Skip sync flush (faster for fast iteration)
  exec --timeout SECS <cmd>
                       Bound the wait on a foreground command; exits 124 if it
                       elapses. Use this instead of wrapping rt in timeout(1) --
                       macOS has no timeout(1), only gtimeout from coreutils.
                       The bound is on the WAIT: the remote process may survive.
  exec --bg [--name N] <cmd>
                       Run in background (tmux), survives disconnection
  logs                 List background jobs for this profile
  logs <job_id>        Show output of a background job
  logs <job_id> -f     Follow (tail -f) a background job's output
  status               Show sync + SSH state for current profile
  status --all         Show all profiles
  verify <path>...     Assert that these paths have ARRIVED: hash them locally,
                       make the remote hash the same paths, compare. Waits until
                       they match. 0 = equal, 2 = blocked/unverifiable, 3 = still
                       different at the deadline. A returned flush does NOT prove
                       equality; this does.
  verify --timeout N --interval N <path>...
                       Bound the wait (default 60s, polling every 2s)
  sync flush           Force sync to reconcile now
  sync status          Detailed Mutagen sync state for this profile
  slurm submit <script> [-- sbatch_args...]
                       Flush sync, then sbatch (requires SLURM_ENABLED=1)
  slurm queue [--all]  Show queue (default: filtered to remote \$USER)
  slurm cancel <id>... scancel one or more job IDs
  slurm logs           List recent submissions for this profile
  slurm logs <id> [-f] [--err]
                       Cat or tail slurm-<id>.out (--err for .err)
  help                 Show this help

EXAMPLES:
  # First-time setup for a new host group + profile
  rt -p fact-cluster/scratch init        # Create host.conf + scratch.conf skeletons
  # Edit \$RT_HOME/fact-cluster/host.conf (REMOTE_HOST, SSH_PORT, SLURM_ENABLED)
  # Edit \$RT_HOME/fact-cluster/scratch.conf (REMOTE_DIR, optional LOCAL_DIR)
  rt -p fact-cluster/scratch setup-key --password 'mypass'
  rt -p fact-cluster/scratch connect
  rt -p fact-cluster/scratch exec "ls -la"
  rt -p fact-cluster/scratch disconnect

  # Adding another profile under the same host group reuses host.conf
  # Edit \$RT_HOME/fact-cluster/ako.conf (just REMOTE_DIR/LOCAL_DIR)
  rt -p fact-cluster/ako connect
  rt status --all

  # HPC / Slurm workflow (SLURM_ENABLED=1 in host.conf or profile.conf)
  rt -p fact-cluster/scratch slurm submit train.sbatch
  rt -p fact-cluster/scratch slurm queue
  rt -p fact-cluster/scratch slurm logs <jobid> -f
  rt -p fact-cluster/scratch slurm cancel <jobid>

ENVIRONMENT:
  RT_HOME              Config & state directory (default: ~/.config/remote-toolkit)

CONFIG LAYOUT (in \$RT_HOME):
  <host>/host.conf        Host-level config (shared by all profiles in the group)
  <host>/<profile>.conf   Profile-specific config

  Host-level (host.conf):
    REMOTE_HOST          user@hostname (or ~/.ssh/config alias) — required
    SSH_PORT             default: 22
    SSH_KEY              default: agent
    SLURM_ENABLED        1 enables 'rt slurm *' (default 0)
    SLURM_SBATCH_ARGS    sbatch args injected before every 'slurm submit'
                         (default: none; explicit '-- ...' args come after
                         these, so they override — sbatch last-wins)

  Profile-level (<profile>.conf):
    REMOTE_DIR           /path/on/remote — required
    LOCAL_DIR            local replica (default: ~/Work/Remote/<host>/<profile>)
    MUTAGEN_SYNC_MODE    default: two-way-resolved
    MUTAGEN_IGNORE_VCS   1 = pass --ignore-vcs (default), 0 = sync .git
    MUTAGEN_IGNORE       bash array of extra ignore patterns
    SLURM_LOG_DIR        where slurm-<id>.out lands (default: \$REMOTE_DIR)
    (any host-level var here overrides the host.conf value)

NOTE: For non-default SSH_PORT or SSH_KEY, also add a Host entry to
~/.ssh/config so Mutagen sync uses the same parameters.
HELP
}

# ── Main dispatch ──────────────────────────────────────────────────
main() {
  # Parse global --profile / -p flag before subcommand
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -p|--profile)
        [[ $# -ge 2 ]] || die "Missing argument for $1. Use: rt -p <host>/<profile> <command> ..."
        RT_PROFILE="$2"
        shift 2
        ;;
      --profile=*)  RT_PROFILE="${1#--profile=}"; shift ;;
      *)            break ;;
    esac
  done

  _init_profile

  local subcmd="${1:-help}"
  shift || true

  case "$subcmd" in
    init)          cmd_init "$@" ;;
    check)         cmd_check "$@" ;;
    setup-key)     cmd_setup_key "$@" ;;
    connect)       cmd_connect "$@" ;;
    disconnect)    cmd_disconnect "$@" ;;
    exec)          cmd_exec "$@" ;;
    status)        cmd_status "$@" ;;
    logs)          cmd_logs "$@" ;;
    sync)          cmd_sync "$@" ;;
    verify)        cmd_verify "$@" ;;
    slurm)         cmd_slurm "$@" ;;
    help|--help|-h) cmd_help ;;
    *)             die "Unknown command: $subcmd. Run 'rt help' for usage." ;;
  esac
}

# Run only when EXECUTED, not when sourced. `test/canary_rt.sh` sources this file to stub `_ssh`
# and assert on the command strings rt sends to the remote — the only way to check them without
# a live host, and this script had no tests at all before 2026-08-02.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
