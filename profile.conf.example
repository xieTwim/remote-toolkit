# Remote Toolkit — profile-level config template
#
# Copy to ~/.config/remote-toolkit/<host-group>/<profile>.conf and edit.
# Sourced AFTER host.conf — values here override host-level ones.
# Workspace-specific.

# REQUIRED: Remote directory to sync
REMOTE_DIR="/home/user/project"

# Optional — local replica path
#   default: ~/Work/Remote/<host-group>/<profile>/
# LOCAL_DIR="$HOME/Work/Remote/<host>/<profile>"

# Optional — Mutagen sync
# MUTAGEN_SYNC_MODE="two-way-resolved"   # two-way-safe|two-way-resolved|one-way-safe|one-way-replica
# MUTAGEN_IGNORE_VCS=1                   # 1 = pass --ignore-vcs (default), 0 = sync .git
# MUTAGEN_IGNORE=(                       # bash array; appended to defaults
#   "data/"
#   "*.bin"
# )
# MUTAGEN_MAX_ENTRY_COUNT=50000         # circuit breaker: HALT this session if it exceeds
#                                       # N filesystem entries (default 50000). Stops a runaway
#                                       # sync (heavy dir missing from IGNORE) from saturating
#                                       # the shared Mutagen daemon and wedging every other
#                                       # profile's `rt exec`. Raise for a legitimately larger
#                                       # project; set empty to disable. Slow ceph-fuse hosts:
#                                       # set lower in host.conf (e.g. 15000).
# MUTAGEN_MAX_STAGING_FILE_SIZE="2GB"   # opt-in: cap individual staged file size

# Optional — Slurm output dir override (host.conf typically sets SLURM_ENABLED)
# SLURM_LOG_DIR="$REMOTE_DIR"            # where slurm-<jobid>.out lands
# SLURM_SBATCH_ARGS=""                   # REPLACES the host.conf value entirely
#                                        # (plain var override, not appended);
#                                        # set "" to drop host defaults for this
#                                        # profile only
